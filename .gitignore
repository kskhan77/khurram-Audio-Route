## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Original source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleasePublic/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
Backup/
UpgradeLog*.htm
# Uncomment if you have tasks that create the TestResults folder
#TestResults/

# MSTest test Results
[Tt]est[Rr]esults/
[Bb]uild[Ll]og.htm

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Code project settings
.vscode/

# External Microsoft driver sample import. Keep reduced SonicFlow driver source in
# Drivers/SonicFlowVirtualAudio/src instead of committing the upstream repo.
Drivers/SonicFlowVirtualAudio/upstream/
Drivers/SonicFlowVirtualAudio/out/

# Logic App local settings file
local.settings.json

# Azure Functions local settings file
local.settings.json

# Visual Studio Server Explorer DB connection settings
*.osql

# Visual Studio Image Manifest results
*.imagemanifest

# Just-In-Time debugger
*.dgml.xml

# Folder for analysis results
/AnalysisResults/

# Microsoft Azure Build Output
*.azurePubxml

# Also ignore .net core publish output
publish/

# Others
Generated\ Files/
[Tt]emp/
[Ww]in32/

# Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# NuGet Packages
**/packages/*
!**/packages/build/
# Uncomment if using NuGet Config to restore packages
# !**/packages/repositories.config

# Microsoft Azure Web App publish settings. Comment the next line if you want to
# publish your settings. However, this file might contain secrets.
*.PublishSettings

# Others
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Tt]emp/
[Ww]in32/
*.sln.metaproj
*.tmp
*.log
