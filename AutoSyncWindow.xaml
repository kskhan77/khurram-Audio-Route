<ui:FluentWindow x:Class="KhurramAudioRoute.AutoSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Auto-sync (L3)"
        Width="540" MinWidth="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True">
    <Grid Margin="20,16,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" TextWrapping="Wrap" Foreground="#B8C4D0"
                   Text="The app plays a short chirp on each ACTIVE output and listens with your microphone to measure how long the sound takes to arrive. Pause other audio and stay quiet. Nothing is uploaded — see docs/LATENCY_PLAN.md (L3)."/>

        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,16,0,0" FontWeight="SemiBold" FontSize="14" Foreground="White"
                   Text="Press Start to begin."/>

        <ItemsControl Grid.Row="2" x:Name="ResultsList" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0FFFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="{Binding DeviceName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding DetailLine}" Foreground="#8B95A2" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StatusBadge}" Foreground="{Binding BadgeBrush}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Margin="0,8,0,0" Foreground="#F08080" FontSize="12" TextWrapping="Wrap" Text=""/>

        <StackPanel Grid.Row="4" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button x:Name="StartBtn" Appearance="Primary" Content="Start" MinWidth="100" Margin="0,0,8,0" Click="OnStartClick"/>
            <ui:Button x:Name="ApplyBtn" Appearance="Primary" Content="Apply" MinWidth="100" Margin="0,0,8,0" Click="OnApplyClick" IsEnabled="False"/>
            <ui:Button x:Name="CancelBtn" Appearance="Secondary" Content="Cancel" MinWidth="100" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
