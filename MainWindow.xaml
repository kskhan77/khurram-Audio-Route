<ui:FluentWindow x:Class="KhurramAudioRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KhurramAudioRoute.ViewModels"
        xmlns:local="clr-namespace:KhurramAudioRoute"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="SonicFlow - Audio Mixer" Width="1350" Height="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.Resources>
        <!-- SonicFlow Colors from design.html -->
        <Color x:Key="SonicSurface">#131313</Color>
        <Color x:Key="SonicSurfaceContainer">#20201F</Color>
        <Color x:Key="SonicSurfaceContainerHigh">#2A2A2A</Color>
        <Color x:Key="SonicPrimary">#B4E4FF</Color>
        <Color x:Key="SonicSecondary">#86DC52</Color>
        <Color x:Key="SonicOutline">#889299</Color>
        <Color x:Key="SonicOnSurface">#E5E2E1</Color>
        <Color x:Key="SonicHeaderBg">#09090B</Color>

        <SolidColorBrush x:Key="SonicSurfaceBrush" Color="{StaticResource SonicSurface}"/>
        <SolidColorBrush x:Key="SonicSurfaceContainerBrush" Color="{StaticResource SonicSurfaceContainer}"/>
        <SolidColorBrush x:Key="SonicSurfaceContainerHighBrush" Color="{StaticResource SonicSurfaceContainerHigh}"/>
        <SolidColorBrush x:Key="SonicPrimaryBrush" Color="{StaticResource SonicPrimary}"/>
        <SolidColorBrush x:Key="SonicSecondaryBrush" Color="{StaticResource SonicSecondary}"/>
        <SolidColorBrush x:Key="SonicOutlineBrush" Color="{StaticResource SonicOutline}"/>
        <SolidColorBrush x:Key="SonicOnSurfaceBrush" Color="{StaticResource SonicOnSurface}"/>
        <SolidColorBrush x:Key="SonicHeaderBgBrush" Color="{StaticResource SonicHeaderBg}"/>

        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <local:PeakToHeightConverter x:Key="PeakToHeightConverter"/>
        <local:SpectrumBarHeightConverter x:Key="SpectrumBarHeightConverter"/>
        <local:ActivityBrushConverter x:Key="ActivityBrushConverter"/>
        <local:SectionVisibilityConverter x:Key="SectionVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Custom Styles -->
        <Style x:Key="SonicSideNavLink" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Foreground" Value="#9098A0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF"/>
                    <Setter Property="Foreground" Value="#E5E2E1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SonicActiveNavLink" TargetType="ui:Button" BasedOn="{StaticResource SonicSideNavLink}">
            <Setter Property="Foreground" Value="#74D1FF"/>
            <Setter Property="Background" Value="#1A00A3FF"/>
            <Setter Property="BorderBrush" Value="#74D1FF"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>

        <Style x:Key="SonicCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SonicSurfaceContainerBrush}"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="SonicSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource SonicPrimaryBrush}"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
        </Style>

        <Style x:Key="SonicComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SonicCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SonicSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SonicOutlineBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SonicCogButton" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource SonicSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Header -->
            <RowDefinition Height="*"/>   <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Border Grid.Row="0" Background="{StaticResource SonicHeaderBgBrush}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SonicFlow" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,32,0"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mixer" Foreground="#74D1FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Devices" Foreground="{StaticResource SonicOutlineBrush}" FontSize="14" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Routing" Foreground="{StaticResource SonicOutlineBrush}" FontSize="14" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Analytics" Foreground="{StaticResource SonicOutlineBrush}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Icon="Alert24" Appearance="Transparent" Foreground="{StaticResource SonicOutlineBrush}" Margin="0,0,8,0"/>
                    <ui:Button Icon="Settings24" Appearance="Transparent" Foreground="{StaticResource SonicOutlineBrush}" Margin="0,0,16,0"/>
                    <Ellipse Width="32" Height="32">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="https://lh3.googleusercontent.com/aida-public/AB6AXuBNCHYEQwKMzIhfjIbqZrKxVD0hUiVL2WdLNE-1tRg94kAtox4GKTbMhcGmklEvdEfmvg8CyFPB-8VDYZzcvmIkVYtPB9nA3o2EfbfS4OsCNz70YC01jqw9tN34SizXQ1m2VBD6b5VH_YXNhB3FS8jcc0-zt88UkqOQG7UMhdaxBzEETyOzhTnTIH5EgP8HBZyHSFo3XnYZT5v9IGGhauGLk0zRFhmaTa8iRPFD3uV7EnP8GCML5MjhXeMTtHfBhkeOZ8o3aaEmjQ"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- 2. Sidebar -->
            <Border Grid.Column="0" Background="#18181B" BorderBrush="#0DFFFFFF" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Master Engine -->
                        <RowDefinition Height="*"/>    <!-- Nav Links -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="16,20,16,24" Padding="14,12" CornerRadius="10" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#1A74D1FF" BorderBrush="#4D74D1FF" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="Pulse24" Foreground="#74D1FF" FontSize="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Master Engine" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="48kHz / 24-bit" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1">
                        <ui:Button Icon="Speaker224" Content="OUTPUTS" Command="{Binding ShowOutputsCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Outputs}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1A00A3FF"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Icon="Apps24" Content="APPLICATIONS" Command="{Binding ShowApplicationsCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Applications}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1A00A3FF"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Icon="Mic24" Content="MIC DEVICES" Command="{Binding ShowMicrophonesCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Microphones}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1A00A3FF"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Icon="GridDots24" Content="OTHER OPTIONS" Command="{Binding ShowToolsCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Tools}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1A00A3FF"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main Mixer -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Outputs}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Available Output Devices" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Set a default device, mirror audio to multiple outputs, and tune per-device volume and EQ." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ui:Button Content="Refresh Devices" Icon="ArrowSync24" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Secondary"
                                       Command="{Binding RefreshDataCommand}"
                                       Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SonicSurfaceContainerBrush}" CornerRadius="14" BorderThickness="1" Margin="0,0,0,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource SonicPrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="{StaticResource SonicSurfaceContainerHighBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Header row: identity + status + cog -->
                                            <Grid Margin="18,16,18,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Round icon -->
                                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" BorderThickness="1" Margin="0,0,14,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#202225"/>
                                                            <Setter Property="BorderBrush" Value="#2B2F33"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="Background" Value="#1A74D1FF"/>
                                                                    <Setter Property="BorderBrush" Value="#4D74D1FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="22">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Foreground" Value="{StaticResource SonicOutlineBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SonicPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Border>

                                                <!-- Name + subtitle -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                        <Border Margin="10,0,0,0" Background="{StaticResource SonicSecondaryBrush}" CornerRadius="10" Padding="8,2"
                                                                Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="DEFAULT" Foreground="#092100" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Margin="8,0,0,0" Background="#1A86DC52" BorderBrush="#86DC52" BorderThickness="1" CornerRadius="10" Padding="8,2"
                                                                Visibility="{Binding IsDuplicating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="MIRRORING" Foreground="#86DC52" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Output device" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <!-- Status / duplicate text -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,18,0">
                                                    <TextBlock Style="{StaticResource SonicSectionHeader}" Text="STATUS" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding DuplicateStatus}" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="11" HorizontalAlignment="Right" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Volume bar -->
                                                <Border Grid.Column="3" VerticalAlignment="Center" Width="120" Height="6" Background="#0FFFFFFF" CornerRadius="3" Margin="0,0,16,0">
                                                    <Border Background="{Binding IsDefault, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3" HorizontalAlignment="Left"
                                                            Width="{Binding Volume, Converter={StaticResource PeakToHeightConverter}, ConverterParameter=120}"/>
                                                </Border>

                                                <!-- Set Default button (hidden when already default) -->
                                                <ui:Button Grid.Column="4"
                                                           Content="Set Default"
                                                           Command="{Binding DataContext.SetDefaultDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Appearance="Primary"
                                                           Padding="12,6"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center">
                                                    <ui:Button.Style>
                                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>

                                                <!-- Cog (toggles advanced) -->
                                                <ToggleButton Grid.Column="5"
                                                              IsChecked="{Binding IsAdvancedExpanded, Mode=TwoWay}"
                                                              Background="#101112"
                                                              BorderBrush="#1AFFFFFF"
                                                              BorderThickness="1"
                                                              Padding="10"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Advanced device settings (duplicate, volume, EQ)">
                                                    <ui:SymbolIcon Symbol="Settings24" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="18"/>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- Advanced panel (inline, no Expander chrome) -->
                                            <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Background="#101112"
                                                    Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Margin="18,16,18,18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- LEFT: Duplicate controls -->
                                                    <StackPanel Grid.Column="0">
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource SonicSectionHeader}" Text="DUPLICATE AUDIO"/>
                                                                <TextBlock Text="Mirror this device's output to additional speakers or headphones." Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <ui:ToggleSwitch Grid.Column="1"
                                                                             IsChecked="{Binding IsDuplicating, Mode=OneWay}"
                                                                             IsEnabled="{Binding IsDuplicateBusy, Converter={StaticResource InverseBooleanConverter}}"
                                                                             Click="OnDuplicateToggleClicked"
                                                                             VerticalAlignment="Center"/>
                                                        </Grid>

                                                        <Border Background="#0A0A0A" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource SonicSectionHeader}" Text="MIRROR TO"/>
                                                                <ItemsControl ItemsSource="{Binding DuplicateTargets}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox Style="{StaticResource SonicCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                                <TextBlock Text="{Binding Device.Name}" TextTrimming="CharacterEllipsis"/>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>

                                                        <TextBlock Text="{Binding DuplicateStatus}" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="11" Margin="2,8,0,0"/>
                                                    </StackPanel>

                                                    <!-- RIGHT: Volume + EQ -->
                                                    <StackPanel Grid.Column="2">
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Style="{StaticResource SonicSectionHeader}" Text="DEVICE VOLUME"/>
                                                            <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        </Grid>
                                                        <Slider Style="{StaticResource SonicSlider}" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="1" ValueChanged="OnOutputDeviceVolumeChanged"/>

                                                        <TextBlock Style="{StaticResource SonicSectionHeader}" Text="EQUALIZER" Margin="0,14,0,8"/>
                                                        <UniformGrid Columns="5" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="60" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqLow, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="250" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqLowMid, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="1K" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqMid, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="4K" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqHighMid, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="12K" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqHigh, Mode=TwoWay}"/>
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <WrapPanel Margin="0,0,0,4">
                                                            <ui:Button Content="Flat" Tag="Flat" Click="OnApplyEqPreset" Appearance="Secondary" Padding="10,5" Margin="0,0,6,6" Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                                                            <ui:Button Content="Bass Boost" Tag="Bass" Click="OnApplyEqPreset" Appearance="Secondary" Padding="10,5" Margin="0,0,6,6" Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                                                            <ui:Button Content="Voice" Tag="Voice" Click="OnApplyEqPreset" Appearance="Secondary" Padding="10,5" Margin="0,0,6,6" Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                                                            <ui:Button Content="Bright" Tag="Bright" Click="OnApplyEqPreset" Appearance="Secondary" Padding="10,5" Margin="0,0,6,6" Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                                                            <ui:Button Content="Reset EQ" Click="OnResetEq" Appearance="Secondary" Padding="10,5" Margin="0,0,0,6" Background="#2B1618" BorderBrush="#6E3036"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Applications}">
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Application Routing" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="Each app routes to one output device. Duplication is intentionally removed from this level." Foreground="{StaticResource SonicOutlineBrush}" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            <ui:Button Content="Refresh Apps" Icon="ArrowSync24" HorizontalAlignment="Right" Appearance="Secondary"
                                       Command="{Binding RefreshDataCommand}"
                                       Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,0,0,48">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SonicCard}" Width="292" Margin="0,0,16,16" Padding="18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="#141A1F" BorderBrush="#22303A" BorderThickness="1" Margin="0,0,12,0">
                                                    <ui:SymbolIcon Symbol="Apps24" Foreground="{StaticResource SonicPrimaryBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" Icon="ArrowSync24" Command="{Binding DataContext.RefreshDataCommand, RelativeSource={RelativeSource AncestorType=Window}}" Appearance="Transparent" Foreground="{StaticResource SonicOutlineBrush}" Padding="4"/>
                                            </Grid>

                                            <Grid Height="42" Margin="0,0,0,16" Opacity="0.9">
                                                <Border Background="#0CFFFFFF" CornerRadius="10" BorderBrush="#12FFFFFF" BorderThickness="1"/>
                                                <UniformGrid Columns="10" VerticalAlignment="Bottom" Margin="8,7,8,7">
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='1.40,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='0.75,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='1.05,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='1.85,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='1.15,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='1.95,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='0.95,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='1.55,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='0.85,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                    <Border Width="6" Height="{Binding PeakValue, Converter={StaticResource SpectrumBarHeightConverter}, ConverterParameter='1.25,5,28'}" Background="{Binding IsPlaying, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="3,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                </UniformGrid>
                                            </Grid>

                                            <StackPanel Margin="0,0,0,16">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="VOLUME" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Style="{StaticResource SonicSlider}" Value="{Binding Volume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          Style="{StaticResource SonicComboBox}"
                                                          ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SelectedTargetDevice, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"/>
                                                <ui:Button Grid.Column="1"
                                                           Content="Route"
                                                           Command="{Binding DataContext.RouteAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="10,0,0,0"
                                                           Appearance="Primary"
                                                           Padding="16,8"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Microphones}">
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Microphone Devices" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="Capture devices and inputs detected on this system." Foreground="{StaticResource SonicOutlineBrush}" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            <ui:Button Content="Refresh Inputs" Icon="Mic24" HorizontalAlignment="Right" Appearance="Secondary"
                                       Command="{Binding RefreshDataCommand}"
                                       Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Microphones}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SonicCard}" Padding="18" Margin="0,0,16,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="54" Height="54" Background="#1E2B34" BorderBrush="#36586D" BorderThickness="1" CornerRadius="14" Margin="0,0,16,0">
                                                <ui:SymbolIcon Symbol="Mic24" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="22"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Input ready for monitoring and future routing tools." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,4,0,8"/>
                                                <Border Width="140" Height="6" Background="#0FFFFFFF" CornerRadius="4">
                                                    <Border Background="{Binding IsDefault, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding Volume, Converter={StaticResource PeakToHeightConverter}, ConverterParameter=140}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Tools}">
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="Other Options" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="26" FontWeight="SemiBold"/>
                        </Grid>

                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="Quick Refresh" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Reload sessions, outputs, and microphone devices." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,8,0,16"/>
                                    <ui:Button Content="Refresh All" Command="{Binding RefreshDataCommand}" Appearance="Primary" Padding="14,8"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="Routing Notes" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Applications route individually. Device duplication will be handled from Outputs in the next step." Foreground="{StaticResource SonicOutlineBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Modern Title Bar Overlay -->
        <ui:TitleBar Grid.Row="0" Grid.RowSpan="2" Title="" Height="32" VerticalAlignment="Top" Background="Transparent"/>
    </Grid>
</ui:FluentWindow>
