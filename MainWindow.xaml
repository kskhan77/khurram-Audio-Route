<ui:FluentWindow x:Class="KhurramAudioRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KhurramAudioRoute.ViewModels"
        xmlns:local="clr-namespace:KhurramAudioRoute"
        xmlns:ctrl="clr-namespace:KhurramAudioRoute.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="SonicFlow - Audio Mixer" Width="1350" Height="900"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Window.Resources>
        <!-- SonicFlow Colors from design.html -->
        <Color x:Key="SonicSurface">#131313</Color>
        <Color x:Key="SonicSurfaceContainer">#20201F</Color>
        <Color x:Key="SonicSurfaceContainerHigh">#2A2A2A</Color>
        <Color x:Key="SonicPrimary">#B4E4FF</Color>
        <Color x:Key="SonicSecondary">#86DC52</Color>
        <Color x:Key="SonicOutline">#889299</Color>
        <Color x:Key="SonicOnSurface">#E5E2E1</Color>
        <Color x:Key="SonicHeaderBg">#09090B</Color>

        <SolidColorBrush x:Key="SonicSurfaceBrush" Color="{StaticResource SonicSurface}"/>
        <SolidColorBrush x:Key="SonicSurfaceContainerBrush" Color="{StaticResource SonicSurfaceContainer}"/>
        <SolidColorBrush x:Key="SonicSurfaceContainerHighBrush" Color="{StaticResource SonicSurfaceContainerHigh}"/>
        <SolidColorBrush x:Key="SonicPrimaryBrush" Color="{StaticResource SonicPrimary}"/>
        <SolidColorBrush x:Key="SonicSecondaryBrush" Color="{StaticResource SonicSecondary}"/>
        <SolidColorBrush x:Key="SonicOutlineBrush" Color="{StaticResource SonicOutline}"/>
        <SolidColorBrush x:Key="SonicOnSurfaceBrush" Color="{StaticResource SonicOnSurface}"/>
        <SolidColorBrush x:Key="SonicHeaderBgBrush" Color="{StaticResource SonicHeaderBg}"/>

        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:PeakToHeightConverter x:Key="PeakToHeightConverter"/>
        <local:SpectrumBarHeightConverter x:Key="SpectrumBarHeightConverter"/>
        <local:ActivityBrushConverter x:Key="ActivityBrushConverter"/>
        <local:SectionVisibilityConverter x:Key="SectionVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Custom Styles -->
        <!-- Sidebar nav items: plain Button with a fully-controlled template
             so theme defaults from WPF-UI can't override the dark-mode look. -->
        <Style x:Key="SonicSideNavLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Foreground" Value="#5E6770"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                                <Setter Property="Foreground" Value="#9CA3AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SonicCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SonicSurfaceContainerBrush}"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="SonicSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource SonicPrimaryBrush}"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
        </Style>

        <Style x:Key="SonicComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SonicCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SonicSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SonicOutlineBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SonicCogButton" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Square icon button used for Set Default / Mute / Cog so all three sit
             together on the device card with identical chrome. -->
        <Style x:Key="SonicIconFrameButton" TargetType="Button">
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same as SonicIconFrameButton but for ToggleButton, with an "is checked" state -->
        <Style x:Key="SonicIconFrameToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F005374"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#74D1FF"/>
                                <Setter Property="Foreground" Value="#74D1FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern volume slider — gradient-fill track, round white thumb, click jumps to point. -->
        <Style x:Key="SonicVolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" CornerRadius="3" Background="#1AFFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="FillBar" Height="6" CornerRadius="3,0,0,3" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#74D1FF" Offset="0"/>
                                                            <GradientStop Color="#7CD0FF" Offset="0.5"/>
                                                            <GradientStop Color="#86DC52" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="Glow" Width="22" Height="22" Fill="#3374D1FF" Opacity="0"/>
                                                    <Ellipse Width="16" Height="16" Fill="White" Stroke="#74D1FF" StrokeThickness="3"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource SonicSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Header -->
            <RowDefinition Height="*"/>   <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- 1. Top Header -->
        <Border Grid.Row="0" Background="{StaticResource SonicHeaderBgBrush}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SonicFlow" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,32,0"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Mixer" Foreground="#74D1FF" FontSize="14" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Devices" Foreground="{StaticResource SonicOutlineBrush}" FontSize="14" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Routing" Foreground="{StaticResource SonicOutlineBrush}" FontSize="14" Margin="0,0,24,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Analytics" Foreground="{StaticResource SonicOutlineBrush}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Icon="Alert24" Appearance="Transparent" Foreground="{StaticResource SonicOutlineBrush}" Margin="0,0,8,0"/>
                    <ui:Button Icon="Settings24" Appearance="Transparent" Foreground="{StaticResource SonicOutlineBrush}" Margin="0,0,16,0"/>
                    <Ellipse Width="32" Height="32">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="https://lh3.googleusercontent.com/aida-public/AB6AXuBNCHYEQwKMzIhfjIbqZrKxVD0hUiVL2WdLNE-1tRg94kAtox4GKTbMhcGmklEvdEfmvg8CyFPB-8VDYZzcvmIkVYtPB9nA3o2EfbfS4OsCNz70YC01jqw9tN34SizXQ1m2VBD6b5VH_YXNhB3FS8jcc0-zt88UkqOQG7UMhdaxBzEETyOzhTnTIH5EgP8HBZyHSFo3XnYZT5v9IGGhauGLk0zRFhmaTa8iRPFD3uV7EnP8GCML5MjhXeMTtHfBhkeOZ8o3aaEmjQ"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- 2. Sidebar -->
            <Border Grid.Column="0" Background="#0E0E10" BorderBrush="#0DFFFFFF" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Master Engine -->
                        <RowDefinition Height="*"/>    <!-- Nav Links -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="16,20,16,24" Padding="14,12" CornerRadius="10" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#1A74D1FF" BorderBrush="#4D74D1FF" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="Pulse24" Foreground="#74D1FF" FontSize="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Master Engine" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="48kHz / 24-bit" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1">
                        <Button Command="{Binding ShowOutputsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Outputs}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1F005374"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Speaker224" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="OUTPUTS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowApplicationsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Applications}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1F005374"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="APPLICATIONS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowMicrophonesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Microphones}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1F005374"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Mic24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MIC DEVICES" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowToolsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Tools}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1F005374"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="GridDots24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <TextBlock Text="OTHER OPTIONS" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sidebar Footer Branding -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="22,0,22,20">
                        <Border Height="1" Background="#1AFFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="SonicFlow" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="by Khurram Shafique" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" FontWeight="SemiBold" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main Mixer -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Outputs}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Available Output Devices" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Set a default device, mirror audio to multiple outputs, and tune per-device volume and EQ." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ui:Button Content="Refresh Devices" Icon="ArrowSync24" HorizontalAlignment="Right" VerticalAlignment="Top" Appearance="Secondary"
                                       Command="{Binding RefreshDataCommand}"
                                       Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SonicSurfaceContainerBrush}" CornerRadius="14" BorderThickness="1" Margin="0,0,0,12">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource SonicPrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="{StaticResource SonicSurfaceContainerHighBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Header: identity + spectrum + small actions -->
                                            <Grid Margin="18,16,14,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Round icon -->
                                                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" BorderThickness="1" Margin="0,0,14,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1B1D20"/>
                                                            <Setter Property="BorderBrush" Value="#262A2F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="Background" Value="#1A74D1FF"/>
                                                                    <Setter Property="BorderBrush" Value="#4D74D1FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="20">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Foreground" Value="{StaticResource SonicOutlineBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SonicPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Border>

                                                <!-- Name + subtitle/status -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                        <Border Margin="10,0,0,0" Background="{StaticResource SonicSecondaryBrush}" CornerRadius="9" Padding="7,2"
                                                                Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="DEFAULT" Foreground="#092100" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Margin="6,0,0,0" Background="#1A86DC52" BorderBrush="#86DC52" BorderThickness="1" CornerRadius="9" Padding="7,1"
                                                                Visibility="{Binding IsDuplicating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="MIRRORING" Foreground="#86DC52" FontSize="9" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DuplicateStatus}" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- Animated rainbow spectrum -->
                                                <ctrl:SpectrumMeter Grid.Column="2"
                                                                    Width="200" Height="44"
                                                                    Margin="14,0,14,0"
                                                                    VerticalAlignment="Center"
                                                                    Level="{Binding PeakValue}"
                                                                    IsActive="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}"
                                                                    BarCount="20"/>

                                                <!-- Set Default — matches cog frame, hidden when already default -->
                                                <Button Grid.Column="3"
                                                        Style="{StaticResource SonicIconFrameButton}"
                                                        Margin="0,0,6,0"
                                                        ToolTip="Set as default playback device"
                                                        Command="{Binding DataContext.SetDefaultDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <ui:SymbolIcon Symbol="Star24" FontSize="16"/>
                                                </Button>

                                                <!-- Cog: opens Advanced (matching frame) -->
                                                <ToggleButton Grid.Column="4"
                                                              Style="{StaticResource SonicIconFrameToggle}"
                                                              IsChecked="{Binding IsAdvancedExpanded, Mode=TwoWay}"
                                                              ToolTip="Advanced (duplicate + EQ)">
                                                    <ui:SymbolIcon Symbol="Settings24" FontSize="16"/>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- Always-visible volume row with mute toggle -->
                                            <Grid Margin="18,0,18,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Mute toggle (icon swaps to mute glyph when muted) -->
                                                <Button Grid.Column="0"
                                                        Style="{StaticResource SonicIconFrameButton}"
                                                        Click="OnDeviceMuteClicked"
                                                        Margin="0,0,10,0"
                                                        Padding="8"
                                                        ToolTip="Mute / Unmute">
                                                    <ui:SymbolIcon FontSize="16">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Speaker224"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                        <Setter Property="Symbol" Value="SpeakerMute24"/>
                                                                        <Setter Property="Foreground" Value="#FF6F8A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Button>

                                                <Slider Grid.Column="1"
                                                        Style="{StaticResource SonicVolumeSlider}"
                                                        Value="{Binding Volume, Mode=TwoWay}"
                                                        Minimum="0" Maximum="1"
                                                        IsEnabled="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}"
                                                        ValueChanged="OnOutputDeviceVolumeChanged"
                                                        VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="SemiBold" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            </Grid>

                                            <!-- Advanced panel (inline) -->
                                            <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Background="#101112"
                                                    Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid Margin="18,16,18,18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- LEFT: Duplicate controls -->
                                                    <StackPanel Grid.Column="0">
                                                        <Grid Margin="0,0,0,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource SonicSectionHeader}" Text="DUPLICATE AUDIO"/>
                                                                <TextBlock Text="Mirror this device's output to additional speakers or headphones." Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                            <ui:ToggleSwitch Grid.Column="1"
                                                                             IsChecked="{Binding IsDuplicating, Mode=OneWay}"
                                                                             IsEnabled="{Binding IsDuplicateBusy, Converter={StaticResource InverseBooleanConverter}}"
                                                                             Click="OnDuplicateToggleClicked"
                                                                             VerticalAlignment="Center"/>
                                                        </Grid>

                                                        <Border Background="#0A0A0A" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource SonicSectionHeader}" Text="MIRROR TO"/>
                                                                <ItemsControl ItemsSource="{Binding DuplicateTargets}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <CheckBox Style="{StaticResource SonicCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                                                <TextBlock Text="{Binding Device.Name}" TextTrimming="CharacterEllipsis"/>
                                                                            </CheckBox>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>

                                                        <TextBlock Text="{Binding DuplicateStatus}" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="11" Margin="2,8,0,0"/>
                                                    </StackPanel>

                                                    <!-- RIGHT: Equalizer -->
                                                    <StackPanel Grid.Column="2">
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource SonicSectionHeader}" Text="EQUALIZER"/>
                                                                <TextBlock Text="Applies to mirrored audio. Enable mirroring to hear changes."
                                                                           Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsDuplicating}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <ui:Button Grid.Column="1" Content="Reset" Click="OnResetEq" Appearance="Secondary" Padding="10,4"
                                                                       Background="#2B1618" BorderBrush="#6E3036" VerticalAlignment="Center"
                                                                       FontSize="11"/>
                                                        </Grid>

                                                        <!-- EQ band sliders with dB readouts -->
                                                        <Border Background="#0A0A0A" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,12">
                                                            <Grid>
                                                                <Grid.Style>
                                                                    <Style TargetType="Grid">
                                                                        <Setter Property="Opacity" Value="0.55"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDuplicating}" Value="True">
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Grid.Style>
                                                                <UniformGrid Columns="5">
                                                                    <StackPanel Margin="3,0">
                                                                        <TextBlock Text="60Hz" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding EqLow, StringFormat={}{0:+0.#;-0.#;0} dB}" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                        <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqLow, Mode=TwoWay}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="3,0">
                                                                        <TextBlock Text="250Hz" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding EqLowMid, StringFormat={}{0:+0.#;-0.#;0} dB}" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                        <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqLowMid, Mode=TwoWay}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="3,0">
                                                                        <TextBlock Text="1kHz" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding EqMid, StringFormat={}{0:+0.#;-0.#;0} dB}" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                        <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqMid, Mode=TwoWay}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="3,0">
                                                                        <TextBlock Text="4kHz" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding EqHighMid, StringFormat={}{0:+0.#;-0.#;0} dB}" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                        <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqHighMid, Mode=TwoWay}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="3,0">
                                                                        <TextBlock Text="12kHz" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding EqHigh, StringFormat={}{0:+0.#;-0.#;0} dB}" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                                        <Slider Style="{StaticResource SonicSlider}" Minimum="-12" Maximum="12" TickFrequency="1" Value="{Binding EqHigh, Mode=TwoWay}"/>
                                                                    </StackPanel>
                                                                </UniformGrid>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Preset chips -->
                                                        <TextBlock Style="{StaticResource SonicSectionHeader}" Text="PRESETS" Margin="0,12,0,6"/>
                                                        <WrapPanel>
                                                            <ui:Button Content="Flat" Tag="Flat" Click="OnApplyEqPreset" Appearance="Secondary" Padding="12,5" Margin="0,0,6,0" Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF" FontSize="11"/>
                                                            <ui:Button Content="Bass Boost" Tag="Bass" Click="OnApplyEqPreset" Appearance="Secondary" Padding="12,5" Margin="0,0,6,0" Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF" FontSize="11"/>
                                                            <ui:Button Content="Voice" Tag="Voice" Click="OnApplyEqPreset" Appearance="Secondary" Padding="12,5" Margin="0,0,6,0" Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF" FontSize="11"/>
                                                            <ui:Button Content="Bright" Tag="Bright" Click="OnApplyEqPreset" Appearance="Secondary" Padding="12,5" Margin="0,0,6,0" Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF" FontSize="11"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Applications}">
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Application Routing" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="Each app routes to one output device. Duplication is intentionally removed from this level." Foreground="{StaticResource SonicOutlineBrush}" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            <ui:Button Content="Refresh Apps" Icon="ArrowSync24" HorizontalAlignment="Right" Appearance="Secondary"
                                       Command="{Binding RefreshDataCommand}"
                                       Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,0,0,48">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SonicCard}" Width="292" Margin="0,0,16,16" Padding="18">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="#141A1F" BorderBrush="#22303A" BorderThickness="1" Margin="0,0,12,0">
                                                    <ui:SymbolIcon Symbol="Apps24" Foreground="{StaticResource SonicPrimaryBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" Icon="ArrowSync24" Command="{Binding DataContext.RefreshDataCommand, RelativeSource={RelativeSource AncestorType=Window}}" Appearance="Transparent" Foreground="{StaticResource SonicOutlineBrush}" Padding="4"/>
                                            </Grid>

                                            <Grid Height="42" Margin="0,0,0,16">
                                                <Border Background="#0CFFFFFF" CornerRadius="10" BorderBrush="#12FFFFFF" BorderThickness="1"/>
                                                <ctrl:SpectrumMeter Margin="8,7,8,7"
                                                                    Level="{Binding PeakValue}"
                                                                    IsActive="{Binding IsPlaying}"
                                                                    BarCount="14"/>
                                            </Grid>

                                            <StackPanel Margin="0,0,0,16">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="VOLUME" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Style="{StaticResource SonicSlider}" Value="{Binding Volume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          Style="{StaticResource SonicComboBox}"
                                                          ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SelectedTargetDevice, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"/>
                                                <ui:Button Grid.Column="1"
                                                           Content="Route"
                                                           Command="{Binding DataContext.RouteAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="10,0,0,0"
                                                           Appearance="Primary"
                                                           Padding="16,8"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Microphones}">
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Microphone Devices" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="26" FontWeight="SemiBold"/>
                                <TextBlock Text="Capture devices and inputs detected on this system." Foreground="{StaticResource SonicOutlineBrush}" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                            <ui:Button Content="Refresh Inputs" Icon="Mic24" HorizontalAlignment="Right" Appearance="Secondary"
                                       Command="{Binding RefreshDataCommand}"
                                       Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Microphones}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SonicCard}" Padding="18" Margin="0,0,16,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="54" Height="54" Background="#1E2B34" BorderBrush="#36586D" BorderThickness="1" CornerRadius="14" Margin="0,0,16,0">
                                                <ui:SymbolIcon Symbol="Mic24" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="22"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Input ready for monitoring and future routing tools." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,4,0,8"/>
                                                <Border Width="140" Height="6" Background="#0FFFFFFF" CornerRadius="4">
                                                    <Border Background="{Binding IsDefault, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding Volume, Converter={StaticResource PeakToHeightConverter}, ConverterParameter=140}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Tools}">
                        <Grid Margin="0,0,0,24">
                            <TextBlock Text="Advanced Tools &amp; Diagnostics" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="26" FontWeight="SemiBold"/>
                        </Grid>

                        <UniformGrid Columns="2">
                            <!-- Test Signal Card -->
                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Audio Test Signal" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Uses BASS to verify high-end audio path &amp; DLLs." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="MusicNote224" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="24"/>
                                    </Grid>
                                    
                                    <ui:Button Command="{Binding ToggleTestToneCommand}" Padding="20,10" HorizontalAlignment="Left">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Start Test Tone"/>
                                                <Setter Property="Appearance" Value="Primary"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTestTonePlaying}" Value="True">
                                                        <Setter Property="Content" Value="Stop Test Tone"/>
                                                        <Setter Property="Appearance" Value="Secondary"/>
                                                        <Setter Property="Background" Value="#2B1618"/>
                                                        <Setter Property="BorderBrush" Value="#6E3036"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Border>

                            <!-- Diagnostic Card -->
                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="Engine Diagnostics" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Run integrity checks on EQ filters and device enumeration." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,8,0,16"/>
                                    <ui:Button Content="Run Core Tests" Click="OnRunDiagnostics" Appearance="Secondary" Padding="14,8"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="Quick Refresh" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Reload sessions, outputs, and microphone devices." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,8,0,16"/>
                                    <ui:Button Content="Refresh All Devices" Command="{Binding RefreshDataCommand}" Appearance="Secondary" Padding="14,8"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="BASS Integration" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Researching high-end BASS library for professional 7.1/Atmos sync." Foreground="{StaticResource SonicOutlineBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Modern Title Bar Overlay -->
        <ui:TitleBar Grid.Row="0" Grid.RowSpan="2" Title="" Height="32" VerticalAlignment="Top" Background="Transparent"/>
    </Grid>
</ui:FluentWindow>
