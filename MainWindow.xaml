<Window x:Class="KhurramAudioRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KhurramAudioRoute.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:KhurramAudioRoute"
        mc:Ignorable="d"
        Title="Khurram Audio Route" Height="820" Width="1020"
        Background="#F3F3F3">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Khurram Audio Route" FontSize="22" FontWeight="Bold" Foreground="#1A1A1A"/>
                <TextBlock Text="Route and duplicate audio per application" FontSize="11" Foreground="#666"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Master:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12"/>
                <Slider Value="{Binding MasterDevice.Volume}" Minimum="0" Maximum="1" Width="110"
                        VerticalAlignment="Center" TickFrequency="0.01" IsSnapToTickEnabled="True">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="ValueChanged">
                            <i:InvokeCommandAction Command="{Binding UpdateMasterVolumeCommand}"
                                                   CommandParameter="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Slider>
                <TextBlock Text="{Binding MasterDevice.Volume, StringFormat={}{0:P0}}" Width="38"
                           Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>

            <Button Grid.Column="2" Content="⟳  Refresh" Command="{Binding RefreshDataCommand}"
                    Padding="14,6" VerticalAlignment="Center"
                    Background="#0078D4" Foreground="White" BorderThickness="0" FontSize="12"/>
        </Grid>

        <!-- ══ Active Audio Applications ══ -->
        <Expander Grid.Row="1" Header="Active Audio Applications" IsExpanded="True" Margin="0,0,0,8"
                  FontSize="13" FontWeight="SemiBold" Background="White" BorderBrush="#D0D0D0" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- App Card -->
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" Margin="6,6,0,6"
                                    Padding="10" Width="230" Background="White" CornerRadius="6">
                                <StackPanel>

                                    <!-- App Name -->
                                    <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}"
                                               FontSize="9" Foreground="#999" Margin="0,0,0,8"/>

                                    <!-- Volume Slider + Peak Meter -->
                                    <Grid Height="130" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Orientation="Vertical" Value="{Binding Volume}"
                                                Minimum="0" Maximum="1" HorizontalAlignment="Center"
                                                TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                                        <ProgressBar Grid.Column="1" Orientation="Vertical"
                                                     Value="{Binding PeakValue, Mode=OneWay}"
                                                     Minimum="0" Maximum="1" Width="10"
                                                     Background="#EBEBEB" Foreground="#107C10"
                                                     BorderThickness="0" VerticalAlignment="Stretch"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Volume, StringFormat='{}{0:P0}'}"
                                               FontSize="9" Foreground="#777" HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>

                                    <!-- ── Route Section ── -->
                                    <Border Background="#F7F7F7" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="ROUTE TO" FontSize="9" Foreground="#0078D4"
                                                       FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding DataContext.Devices,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding SelectedTargetDevice, Mode=TwoWay}"
                                                      DisplayMemberPath="Name"
                                                      FontSize="10" Height="24" Margin="0,0,0,5"/>
                                            <Button Content="Apply Route"
                                                    Command="{Binding DataContext.RouteAppCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="10" Padding="0,4" Background="#0078D4"
                                                    Foreground="White" BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ── Duplicate Section ── -->
                                    <Border Background="#F7FFF7" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="DUPLICATE TO" FontSize="9" Foreground="#107C10"
                                                       FontWeight="Bold" Margin="0,0,0,4"/>
                                            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"
                                                          Margin="0,0,0,5">
                                                <ItemsControl ItemsSource="{Binding TargetDevices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Device.Name}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      FontSize="9" Margin="0,1"
                                                                      VerticalContentAlignment="Center"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <!-- Toggle button: green "Start" ↔ red "Stop" -->
                                            <Button Command="{Binding DataContext.ToggleDuplicateCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="10" Padding="0,4">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="▶  Start Duplicate"/>
                                                        <Setter Property="Background" Value="#107C10"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDuplicating}" Value="True">
                                                                <Setter Property="Content" Value="■  Stop Duplicate"/>
                                                                <Setter Property="Background" Value="#C42B1C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Mute toggle -->
                                    <ToggleButton IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                  FontSize="10" Padding="0,4">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Content" Value="Mute"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Content" Value="🔇 Muted"/>
                                                        <Setter Property="Background" Value="#E81123"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Expander>

        <!-- ══ Available Output Devices ══ -->
        <Expander Grid.Row="2" Header="Available Output Devices  (click to set as system default)"
                  IsExpanded="True" FontSize="13" FontWeight="SemiBold"
                  Background="White" BorderBrush="#D0D0D0" BorderThickness="1">
            <GroupBox Header="" Padding="4" BorderThickness="0" Height="200">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SetDefaultDeviceCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        Margin="3" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DeviceBorder" BorderBrush="#D0D0D0" BorderThickness="1"
                                                    CornerRadius="4" Padding="8,6" Background="White">
                                                <Grid Background="Transparent">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                   FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock x:Name="DefaultLabel" Text="● DEFAULT"
                                                                   FontSize="9" Foreground="#0078D4"
                                                                   FontWeight="Bold" Visibility="Collapsed"
                                                                   Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <ProgressBar Grid.Column="1" Value="{Binding PeakValue}"
                                                                 Minimum="0" Maximum="1" Width="50" Height="4"
                                                                 VerticalAlignment="Center" Margin="8,0,0,0"
                                                                 Background="#EEE" Foreground="#107C10"
                                                                 BorderThickness="0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DeviceBorder" Property="Background" Value="#F5F5F5"/>
                                                    <Setter TargetName="DeviceBorder" Property="BorderBrush" Value="#AAAAAA"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                    <Setter TargetName="DeviceBorder" Property="Background" Value="#EEF6FF"/>
                                                    <Setter TargetName="DeviceBorder" Property="BorderBrush" Value="#0078D4"/>
                                                    <Setter TargetName="DefaultLabel" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
        </Expander>
    </Grid>
</Window>
