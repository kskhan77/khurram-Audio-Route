<ui:FluentWindow x:Class="KhurramAudioRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KhurramAudioRoute.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:KhurramAudioRoute"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Khurram Audio Route" Width="1040"
        SizeToContent="Height"
        ExtendsContentIntoAppWindow="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterScreen">
    
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Bar -->
            <RowDefinition Height="Auto"/> <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Modern Title Bar -->
        <ui:TitleBar Title="Khurram Audio Route" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Speaker224" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="20,10,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header Stats -->
                <RowDefinition Height="Auto"/> <!-- Applications -->
                <RowDefinition Height="Auto"/> <!-- Devices -->
            </Grid.RowDefinitions>

            <!-- ══ Header Stats ══ -->
            <ui:Card Grid.Row="0" Margin="0,0,0,16" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Khurram Audio Route" FontSize="24" FontWeight="Bold" />
                        <TextBlock Text="Route and duplicate audio per application" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                            <ui:SymbolIcon Symbol="SpeakerSettings24" Margin="0,0,10,0" />
                            <TextBlock Text="Master:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <Slider Value="{Binding MasterDevice.Volume}" Minimum="0" Maximum="1" Width="120"
                                    VerticalAlignment="Center" SmallChange="0.01" LargeChange="0.1">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="ValueChanged">
                                        <i:InvokeCommandAction Command="{Binding UpdateMasterVolumeCommand}"
                                                               CommandParameter="{Binding Value, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Slider>
                            <TextBlock Text="{Binding MasterDevice.Volume, StringFormat={}{0:P0}}" Width="40"
                                       Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>

                        <ui:Button Content="Refresh" Icon="ArrowCounterclockwise24" 
                                   Command="{Binding RefreshDataCommand}"
                                   Appearance="Primary" Padding="16,8"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- ══ Active Audio Applications ══ -->
            <ui:Expander Grid.Row="1" Header="Active Audio Applications" IsExpanded="True" Margin="0,0,0,12"
                         Icon="Apps24">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- App Card -->
                                <ui:Card Margin="0,0,12,12" Width="260" Padding="16">
                                    <StackPanel>
                                        <!-- App Name -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" FontSize="14"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}"
                                                           FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                            <ui:SymbolIcon Grid.Column="1" Symbol="MusicNote224" />
                                        </Grid>

                                        <!-- Volume Slider + Peak Meter -->
                                        <Grid Height="140" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Orientation="Vertical" Value="{Binding Volume}"
                                                    Minimum="0" Maximum="1" HorizontalAlignment="Center"
                                                    SmallChange="0.01" LargeChange="0.1"/>
                                            <ProgressBar Grid.Column="1" Orientation="Vertical"
                                                         Value="{Binding PeakValue, Mode=OneWay}"
                                                         Minimum="0" Maximum="1" Width="8"
                                                         CornerRadius="4"
                                                         Background="{DynamicResource ControlFillColorDefaultBrush}" 
                                                         Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                         BorderThickness="0" VerticalAlignment="Stretch"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Volume, StringFormat='{}{0:P0}'}"
                                                   FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Margin="0,0,0,12"/>

                                        <!-- ── Route Section ── -->
                                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="ROUTE TO" FontSize="10" FontWeight="Black" Margin="0,0,0,8"
                                                           Foreground="{DynamicResource SystemFillColorPrimaryBrush}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.Devices,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SelectedTargetDevice, Mode=TwoWay}"
                                                          DisplayMemberPath="Name"
                                                          Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                                                <ui:Button Content="Apply Route" Icon="ArrowRight24"
                                                           Command="{Binding DataContext.RouteAppCommand,
                                                               RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           HorizontalAlignment="Stretch" Appearance="Secondary"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- ── Duplicate Section ── -->
                                        <Border Background="{DynamicResource ControlFillColorTertiaryBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="DUPLICATE TO" FontSize="10" FontWeight="Black" Margin="0,0,0,8"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                                <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                                    <ItemsControl ItemsSource="{Binding TargetDevices}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Device.Name}"
                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          FontSize="11" Margin="0,2"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                
                                                <ui:Button Command="{Binding DataContext.ToggleDuplicateCommand,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch">
                                                    <ui:Button.Style>
                                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                            <Setter Property="Content" Value="Start Duplicate"/>
                                                            <Setter Property="Icon" Value="Play24"/>
                                                            <Setter Property="Appearance" Value="Success"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDuplicating}" Value="True">
                                                                    <Setter Property="Content" Value="Stop Duplicate"/>
                                                                    <Setter Property="Icon" Value="Stop24"/>
                                                                    <Setter Property="Appearance" Value="Danger"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>

                                        <!-- Mute toggle -->
                                        <ui:ToggleSwitch IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                       Content="Mute Session"
                                                       HorizontalAlignment="Center"/>

                                    </StackPanel>
                                </ui:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ui:Expander>

            <!-- ══ Available Output Devices ══ -->
            <ui:Expander Grid.Row="2" Header="Available Output Devices"
                      IsExpanded="True" Icon="Speaker224">
                <ui:Card Padding="12" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                        <ItemsControl ItemsSource="{Binding Devices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Command="{Binding DataContext.SetDefaultDeviceCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Margin="4" HorizontalContentAlignment="Stretch"
                                            Padding="12,10" Appearance="Secondary">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           FontSize="13" TextWrapping="Wrap"/>
                                                <TextBlock x:Name="DefaultLabel" Text="● DEFAULT DEVICE"
                                                           FontSize="10" Foreground="{DynamicResource SystemFillColorPrimaryBrush}"
                                                           FontWeight="Black" Visibility="Collapsed"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1" Value="{Binding PeakValue}"
                                                         Minimum="0" Maximum="1" Width="60" Height="6"
                                                         VerticalAlignment="Center" Margin="12,0,0,0"
                                                         CornerRadius="3"
                                                         Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                                        </Grid>
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="Appearance" Value="Primary"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter TargetName="DefaultLabel" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </ui:Card>
            </ui:Expander>
        </Grid>
    </Grid>
</ui:FluentWindow>