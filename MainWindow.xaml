<ui:FluentWindow x:Class="KhurramAudioRoute.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KhurramAudioRoute.ViewModels"
        xmlns:local="clr-namespace:KhurramAudioRoute"
        xmlns:core="clr-namespace:KhurramAudioRoute.Core"
        xmlns:ctrl="clr-namespace:KhurramAudioRoute.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="SonicFlow — Playback &amp; profiles" Width="1180" Height="860"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Icon="Assets/app_icon.ico">

    <Window.Resources>
        <ContextMenu x:Key="TrayMenu" x:Name="TrayMenu">
            <MenuItem Header="Show SonicFlow" Click="OnShowAppClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Window24"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <!-- Master power toggle. Header tracks state via the tray Click handler. -->
            <MenuItem x:Name="TrayPowerMenuItem" Header="Turn Application ON" Click="OnTrayPowerClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Pulse24"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Exit" Click="OnExitAppClicked">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="SignOut24"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <!-- SonicFlow Colors from design.html -->
        <Color x:Key="SonicSurface">#131313</Color>
        <Color x:Key="SonicSurfaceContainer">#20201F</Color>
        <Color x:Key="SonicSurfaceContainerHigh">#2A2A2A</Color>
        <Color x:Key="SonicPrimary">#B4E4FF</Color>
        <Color x:Key="SonicSecondary">#86DC52</Color>
        <Color x:Key="SonicOutline">#889299</Color>
        <Color x:Key="SonicOnSurface">#E5E2E1</Color>
        <Color x:Key="SonicHeaderBg">#09090B</Color>

        <SolidColorBrush x:Key="SonicSurfaceBrush" Color="{StaticResource SonicSurface}"/>
        <SolidColorBrush x:Key="SonicSurfaceContainerBrush" Color="{StaticResource SonicSurfaceContainer}"/>
        <SolidColorBrush x:Key="SonicSurfaceContainerHighBrush" Color="{StaticResource SonicSurfaceContainerHigh}"/>
        <SolidColorBrush x:Key="SonicPrimaryBrush" Color="{StaticResource SonicPrimary}"/>
        <SolidColorBrush x:Key="SonicSecondaryBrush" Color="{StaticResource SonicSecondary}"/>
        <SolidColorBrush x:Key="SonicOutlineBrush" Color="{StaticResource SonicOutline}"/>
        <SolidColorBrush x:Key="SonicOnSurfaceBrush" Color="{StaticResource SonicOnSurface}"/>
        <SolidColorBrush x:Key="SonicHeaderBgBrush" Color="{StaticResource SonicHeaderBg}"/>

        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <local:PeakToHeightConverter x:Key="PeakToHeightConverter"/>
        <local:SpectrumBarHeightConverter x:Key="SpectrumBarHeightConverter"/>
        <local:ActivityBrushConverter x:Key="ActivityBrushConverter"/>
        <local:SectionVisibilityConverter x:Key="SectionVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <local:EqPresetKeyMatchConverter x:Key="EqPresetKeyMatchConverter"/>
        <local:PlaybackNameSuggestsHeadphonesConverter x:Key="PlaybackNameSuggestsHeadphonesConverter"/>



        <local:SpatialPresetEnumMatchConverter x:Key="SpatialPresetEnumMatchConverter"/>
        <local:VoicePresetEnumMatchConverter x:Key="VoicePresetEnumMatchConverter"/>
        <local:StudioPolishPresetEnumMatchConverter x:Key="StudioPolishPresetEnumMatchConverter"/>
        <local:ReverbPresetEnumMatchConverter x:Key="ReverbPresetEnumMatchConverter"/>
        <local:NoiseReductionPresetEnumMatchConverter x:Key="NoiseReductionPresetEnumMatchConverter"/>

        <!-- Custom Styles -->
        <Style x:Key="SonicHeaderNavLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8A939C"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="#C8D4DC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar nav items: plain Button with a fully-controlled template
             so theme defaults from WPF-UI can't override the dark-mode look. -->
        <Style x:Key="SonicSideNavLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="Foreground" Value="#5E6770"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                                <Setter Property="Foreground" Value="#9CA3AC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SonicCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SonicSurfaceContainerBrush}"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="SonicSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{StaticResource SonicPrimaryBrush}"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
        </Style>

        <!-- Dark ComboBoxItem used inside SonicComboBox's popup. Sets text color
             and provides hover / selected states without going through the system
             theme (which renders white-on-white in some Windows configurations). -->
        <Style x:Key="SonicComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A74D1FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2674D1FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SonicComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SonicComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                      Width="8" Height="4"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border Background="#101112"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Playback device picker: readable profile + endpoint names in dropdown and selection box -->
        <Style x:Key="SonicComboBoxDeviceList" TargetType="ComboBox" BasedOn="{StaticResource SonicComboBox}">
            <Setter Property="MaxDropDownHeight" Value="380"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="TextSearch.TextPath" Value="UiListLabel"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type core:AudioDevice}">
                        <TextBlock Text="{Binding UiListLabel}"
                                   ToolTip="{Binding UiListLabel}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="2,6"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SonicCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SonicSectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SonicOutlineBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SonicCogButton" TargetType="ui:Button">
            <Setter Property="Appearance" Value="Secondary"/>
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Square icon button used for Set Default / Mute / Cog so all three sit
             together on the device card with identical chrome. -->
        <Style x:Key="SonicIconFrameButton" TargetType="Button">
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- After SonicIconFrameButton so StaticResource resolves -->
        <Style x:Key="SonicLatencyAdjustButton" TargetType="Button" BasedOn="{StaticResource SonicIconFrameButton}">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C8DCE8"/>
        </Style>

        <!-- Latency +/- : 28px circle matches compact mirror row icon scale -->
        <Style x:Key="SonicLatencyGlyphButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AABDD2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#D4E8F8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SonicEqPresetRadio" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#9CA8B3"/>
            <Setter Property="Background" Value="#1A1F26"/>
            <Setter Property="BorderBrush" Value="#2A323C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#3B4148"/>
                                <Setter TargetName="Outer" Property="Background" Value="#22272F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource SonicPrimaryBrush}"/>
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource SonicPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="#0A1218"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Compact preset chips (~half toolbar height vs SonicEqPresetRadio).
             MinWidth=58 keeps chips visually uniform inside a WrapPanel so the
             eye reads a clean grid even though each chip sizes to its content. -->
        <Style x:Key="SonicEqPresetRadioCompact" TargetType="RadioButton" BasedOn="{StaticResource SonicEqPresetRadio}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- Spatial mode picker pills. Compact enough that all 7 fit in a single
             WrapPanel row at typical window widths; on narrower windows the
             panel wraps the rest to a second row automatically. MinWidth
             keeps each pill visually balanced so the strip reads as a clean
             strip when wrapped. -->
        <Style x:Key="SonicSpatialPresetListRadio" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#B4C4D8"/>
            <Setter Property="Background" Value="#111921"/>
            <Setter Property="BorderBrush" Value="#243547"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="#192231"/>
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#364B63"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource SonicPrimaryBrush}"/>
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource SonicPrimaryBrush}"/>
                                <Setter Property="Foreground" Value="#081018"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="#5EB8EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One compact row per device: checkbox + 32px icon + name/status + delay stepper -->
        <DataTemplate x:Key="MirrorPlaybackTargetRow" DataType="{x:Type core:DeviceSelection}">
            <Border Background="#10161C" CornerRadius="8" Margin="0,0,0,4" Padding="8,6" BorderBrush="#1C2836" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="M_ShChk"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="M_ShIco"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="M_ShDly" MinWidth="148"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                              Style="{StaticResource SonicCheckBox}" Margin="2,0,6,0"
                              ToolTip="Mirror to this playback device"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>

                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0"
                            Background="#1A2430" BorderBrush="#2A3948" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <ui:SymbolIcon Symbol="Headphones24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="16" Foreground="{StaticResource SonicPrimaryBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Device.Name, Converter={StaticResource PlaybackNameSuggestsHeadphonesConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                            <ui:SymbolIcon Symbol="Speaker224" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="16" Foreground="{StaticResource SonicOutlineBrush}">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Device.Name, Converter={StaticResource PlaybackNameSuggestsHeadphonesConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding Device.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SonicOnSurfaceBrush}"
                                   ToolTip="{Binding Device.UiListLabel}" MaxWidth="420"/>
                        <TextBlock Text=" · " VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#4A5560" FontSize="11"/>
                        <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="STANDBY"/>
                                    <Setter Property="Foreground" Value="#5C6570"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Text" Value="ACTIVE"/>
                                            <Setter Property="Foreground" Value="{StaticResource SonicSecondaryBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="3" CornerRadius="8" Background="#151C26" BorderBrush="#2A3848" BorderThickness="1"
                            Padding="1,2" VerticalAlignment="Center" HorizontalAlignment="Right" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="−" Click="OnDecreaseLatency" Tag="{Binding}"
                                    Style="{StaticResource SonicLatencyGlyphButton}"
                                    ToolTip="Earlier — less delay vs other mirrors"/>
                            <Border Width="1" Background="#2A3444" Margin="3,5" VerticalAlignment="Stretch"/>
                            <TextBlock MinWidth="52" Margin="6,2,6,2" Padding="2,4" VerticalAlignment="Center"
                                       Text="{Binding LatencyOffsetMs, StringFormat='{}{0:+0;-0;0}'}"
                                       TextAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource SonicPrimaryBrush}">
                                <TextBlock.ToolTip>
                                    <TextBlock MaxWidth="260" TextWrapping="Wrap" Text="Offset in milliseconds (+ later, − earlier)."/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Text="ms" VerticalAlignment="Center" Margin="-2,0,4,0" FontSize="10" FontWeight="SemiBold" Foreground="#7E90A6"/>
                            <Border Width="1" Background="#2A3444" Margin="0,5" VerticalAlignment="Stretch"/>
                            <Button Content="+" Click="OnIncreaseLatency" Tag="{Binding}"
                                    Style="{StaticResource SonicLatencyGlyphButton}"
                                    ToolTip="Later — more delay"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Same as SonicIconFrameButton but for ToggleButton, with an "is checked" state -->
        <Style x:Key="SonicIconFrameToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#101112"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F005374"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#74D1FF"/>
                                <Setter Property="Foreground" Value="#74D1FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern volume slider — gradient-fill track, round white thumb, click jumps to point. -->
        <Style x:Key="SonicVolumeSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" CornerRadius="3" Background="#1AFFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="FillBar" Height="6" CornerRadius="3,0,0,3" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#74D1FF" Offset="0"/>
                                                            <GradientStop Color="#7CD0FF" Offset="0.5"/>
                                                            <GradientStop Color="#86DC52" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="Glow" Width="22" Height="22" Fill="#3374D1FF" Opacity="0"/>
                                                    <Ellipse Width="16" Height="16" Fill="White" Stroke="#74D1FF" StrokeThickness="3"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource SonicSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/> <!-- Header -->
            <RowDefinition Height="*"/>   <!-- Content Area -->
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="Assets/app_icon.ico"
                        ToolTipText="SonicFlow — virtual playback &amp; routing"
                        ContextMenu="{StaticResource TrayMenu}"
                        TrayMouseDoubleClick="OnTrayIconDoubleClick"/>

        <!-- 1. Top header — section tabs mirror the sidebar (VB-style control-panel flow) -->
        <Border Grid.Row="0" Background="{StaticResource SonicHeaderBgBrush}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
            <Grid Margin="20,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SonicFlow" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="·" Foreground="#3FFFFFFF" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="playback &amp; routing" Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding ShowOutputsCommand}" Content="Playback &amp; profiles">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SonicHeaderNavLink}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Outputs}">
                                        <Setter Property="Foreground" Value="#74D1FF"/>
                                        <Setter Property="BorderBrush" Value="#3374D1FF"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Background" Value="#14005374"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ShowApplicationsCommand}" Content="Per-app routing">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SonicHeaderNavLink}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Applications}">
                                        <Setter Property="Foreground" Value="#74D1FF"/>
                                        <Setter Property="BorderBrush" Value="#3374D1FF"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Background" Value="#14005374"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ShowMicrophonesCommand}" Content="Recording">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SonicHeaderNavLink}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Microphones}">
                                        <Setter Property="Foreground" Value="#74D1FF"/>
                                        <Setter Property="BorderBrush" Value="#3374D1FF"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Background" Value="#14005374"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding ShowToolsCommand}" Content="Tools">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SonicHeaderNavLink}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Tools}">
                                        <Setter Property="Foreground" Value="#74D1FF"/>
                                        <Setter Property="BorderBrush" Value="#3374D1FF"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="Background" Value="#14005374"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="278"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Content -->
            </Grid.ColumnDefinitions>

            <!-- 2. Sidebar -->
            <Border Grid.Column="0" Background="#0E0E10" BorderBrush="#0DFFFFFF" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="14,18,14,14" Padding="14,12" CornerRadius="10" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" Background="#1A74D1FF" BorderBrush="#4D74D1FF" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0">
                                <ui:SymbolIcon Symbol="Pulse24" Foreground="#74D1FF" FontSize="20"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Mixer engine" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                <TextBlock Text="playback path · typical 48 kHz session" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                    <StackPanel>
                        <Button Command="{Binding ShowOutputsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Outputs}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1F005374"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Speaker224" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Playback" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold"/>
                                    <TextBlock Text="profiles &amp; devices" FontSize="9" Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowApplicationsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Applications}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1F005374"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Per-app routing" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold"/>
                                    <TextBlock Text="send apps to a device" FontSize="9" Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowMicrophonesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Microphones}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1F005374"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Mic24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Recording" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold"/>
                                    <TextBlock Text="capture devices" FontSize="9" Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowToolsCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SonicSideNavLink}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentSection}" Value="{x:Static vm:DashboardSection.Tools}">
                                            <Setter Property="Foreground" Value="#74D1FF"/>
                                            <Setter Property="Background" Value="#1F005374"/>
                                            <Setter Property="BorderBrush" Value="#74D1FF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="GridDots24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Tools" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="SemiBold"/>
                                    <TextBlock Text="signals &amp; diagnostics" FontSize="9" Foreground="#6B7280"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer Branding -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="22,0,22,20">
                        <Border Height="1" Background="#1AFFFFFF" Margin="0,0,0,12"/>
                        <TextBlock Text="SonicFlow" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="by Khurram Shafique" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" FontWeight="SemiBold" Opacity="0.7"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main Mixer -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24">
                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Outputs}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Playback &amp; profiles" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Turn Application ON to route audio through SonicFlow (VB-CABLE → master EQ + spatial → ACTIVE outputs). Tune master EQ/spatial once and tick ACTIVE on every device that should hear the processed audio." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <ui:Button Command="{Binding PlayBridgeTestToneCommand}"
                                           Icon="Speaker224"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           MinHeight="32"
                                           Padding="12,6"
                                           Content="Test bus output"
                                           IsEnabled="{Binding Power.IsActive}"
                                           ToolTip="Play a 1 kHz tone through the SonicFlow bridge to verify it's reaching every ACTIVE device. Confirms the entire route (master EQ + spatial → ACTIVE outputs → speakers) without needing any app to play through VB-CABLE."/>
                                <ui:Button Command="{Binding TogglePowerCommand}"
                                           Content="{Binding Power.BusChipShortLabel}"
                                           Icon="Power20"
                                           Appearance="Secondary"
                                           Margin="0,0,8,0"
                                           MinHeight="32"
                                           Padding="12,6"
                                           IsEnabled="{Binding Power.IsTransitioning, Converter={StaticResource InverseBooleanConverter}}"
                                           ToolTipService.InitialShowDelay="200"
                                           ToolTipService.ShowDuration="20000">
                                    <ui:Button.ToolTip>
                                        <ToolTip MaxWidth="320">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">SonicFlow Application</TextBlock>
                                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SonicOutlineBrush}"
                                                           Text="{Binding Power.StatusMessage}"/>
                                                <TextBlock Margin="0,6,0,0" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource SonicPrimaryBrush}"
                                                           Text="{Binding TotalLatencyBanner}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </ui:Button.ToolTip>
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button">
                                            <Setter Property="Appearance" Value="Secondary"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Power.IsActive}" Value="True">
                                                    <Setter Property="Appearance" Value="Primary"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Power.IsTransitioning}" Value="True">
                                                    <Setter Property="Appearance" Value="Caution"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <ui:Button Content="Sync wizard" Icon="SoundSource24" Appearance="Secondary" Margin="0,0,8,0"
                                           Command="{Binding OpenSyncCalibrationWizardCommand}"
                                           ToolTip="3-tap perceptual sync vs a timing reference — see docs/LATENCY_PLAN.md (L2)."
                                           Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                                <ui:Button Content="Auto-sync" Icon="MicSparkle24" Appearance="Secondary" Margin="0,0,8,0"
                                           Command="{Binding OpenAutoSyncWizardCommand}"
                                           ToolTip="Mic-based auto-sync: plays a chirp on each ACTIVE output and listens via the system microphone — see docs/LATENCY_PLAN.md (L3)."
                                           Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                                <ui:Button Content="Refresh list" Icon="ArrowSync24" Appearance="Secondary"
                                           Command="{Binding RefreshDataCommand}"
                                           ToolTip="Re-enumerate playback and capture devices. Use after plugging or unplugging a USB device."
                                           Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                            </StackPanel>
                        </Grid>

                        <!-- v1-first-run cue: VB-CABLE is the production bus (docs/PLAN.md). -->
                        <Border Margin="0,0,0,16" Padding="14,12" CornerRadius="10"
                                Background="#1AF5A623" BorderBrush="#66E3B341" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Power.IsBusInstalled}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="VB-Audio VB-CABLE is not installed." FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource SonicOnSurfaceBrush}"/>
                                <TextBlock Margin="0,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource SonicOutlineBrush}">
                                    Install VB-CABLE for SonicFlow&apos;s routed master bus—Windows apps play into the cable, this app EQs/spatialises once, and ACTIVE outputs get the mirror. Without VB-CABLE, backup mode taps your current default playback device (that endpoint stays dry; other ACTIVE outputs carry the FX).
                                    <Hyperlink NavigateUri="https://vb-audio.com/Cable/" RequestNavigate="OnHyperlinkRequestNavigate" Foreground="#74D1FF">
                                        Download VB-Audio VB-CABLE
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Master output strip on the Outputs page: master mute + volume for the system
                             default device. Mirrors the strip on the Applications page so users get the
                             same global "kill-switch + level" controls regardless of which tab they're on. -->
                        <Border Style="{StaticResource SonicCard}" Padding="16,12" Margin="0,0,0,16"
                                DataContext="{Binding MasterDevice}"
                                Visibility="{Binding ., Converter={StaticResource NullToCollapsedConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                        Background="#1A74D1FF" BorderBrush="#4D74D1FF" BorderThickness="1" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Speaker224" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="18"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Windows default playback" Foreground="{StaticResource SonicOutlineBrush}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                </StackPanel>

                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource SonicIconFrameButton}"
                                            Click="OnOutputsMasterMuteClicked"
                                            Margin="0,0,10,0"
                                            Padding="8"
                                            ToolTip="Mute every output device (silences all audio)">
                                        <ui:SymbolIcon FontSize="16">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Speaker224"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Symbol" Value="SpeakerMute24"/>
                                                            <Setter Property="Foreground" Value="#FF6F8A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Button>
                                    <Slider Grid.Column="1"
                                            Style="{StaticResource SonicVolumeSlider}"
                                            Value="{Binding Volume, Mode=TwoWay}"
                                            Minimum="0" Maximum="1"
                                            IsEnabled="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}"
                                            ValueChanged="OnOutputsMasterVolumeChanged"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="SemiBold" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Master engine: a single bus-level EQ + spatial that applies to every active output.
                             Works only when Audio bus is on (Outputs toolbar). See docs/AUDIO_BUS_PLAN.md. -->
                        <Border CornerRadius="14" Padding="16,14" Margin="0,0,0,18"
                                Background="{StaticResource SonicSurfaceContainerBrush}"
                                BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 0: header -->
                                    <RowDefinition Height="Auto"/> <!-- 1: bridge live / why EQ may be dry -->
                                    <RowDefinition Height="Auto"/> <!-- 2: EQ sliders -->
                                    <RowDefinition Height="Auto"/> <!-- 3: EQ preset chips -->
                                    <RowDefinition Height="Auto"/> <!-- 4: spatial header row -->
                                    <RowDefinition Height="Auto"/> <!-- 5: spatial pill grid -->
                                    <RowDefinition Height="Auto"/> <!-- 6: stereo width slider -->
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9"
                                            VerticalAlignment="Center"
                                            Background="#1A74D1FF" BorderBrush="#5474D1FF" BorderThickness="1"
                                            Margin="0,0,12,0">
                                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="18" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{StaticResource SonicPrimaryBrush}"/>
                                    </Border>
                                    <ui:Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetMasterEqualizerCommand}"
                                               Appearance="Secondary"
                                               Padding="8,4" MinHeight="28" MaxHeight="28"
                                               Background="#2B1618" BorderBrush="#6E3036" FontSize="11"
                                               Icon="ArrowSync24" ToolTip="Reset every master EQ band to 0 dB"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Master engine" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SonicOnSurfaceBrush}"
                                                   ToolTipService.ShowDuration="20000">
                                            <TextBlock.ToolTip>
                                                <ToolTip MaxWidth="320">
                                                    <TextBlock TextWrapping="Wrap" MaxWidth="320">
                                                    One EQ + spatial pipeline applied to every active output. Engages when Audio bus is on (Outputs toolbar or tray).</TextBlock>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource SonicOutlineBrush}" Margin="0,2,0,0">
                                            <Run Text="10-band EQ + spatial preset shared across every"/>
                                            <Run Text="● Active" Foreground="{StaticResource SonicSecondaryBrush}" FontWeight="SemiBold"/>
                                            <Run Text="output."/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>

                                <Border Grid.Row="1" Margin="0,0,0,10" Padding="10,8" CornerRadius="8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#14005374"/>
                                            <Setter Property="BorderBrush" Value="#3374D1FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMasterBridgeLive}" Value="False">
                                                    <Setter Property="Background" Value="#1AF5A623"/>
                                                    <Setter Property="BorderBrush" Value="#66E3B341"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding MasterEngineStatusHint}" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource SonicOnSurfaceBrush}"/>
                                </Border>

                                <!-- 10-band EQ sliders (compact). Each binds to MasterEqBandN on the view model. -->
                                <UniformGrid Grid.Row="2" Columns="10">
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand0, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="31" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand1, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="62" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand2, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="125" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand3, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="250" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand4, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="500" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand5, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="1k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand6, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="2k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand7, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="4k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand8, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="8k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                        <Slider Orientation="Vertical" Height="60" Minimum="-12" Maximum="12" Value="{Binding MasterEqBand9, Mode=TwoWay}"
                                                Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                        <TextBlock Text="16k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="8" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- EQ preset chips. WrapPanel so each chip sizes to its content
                                     instead of UniformGrid's equal-column-width (which left
                                     enormous whitespace inside every chip). Built-in presets
                                     wrap densely; custom slots sit on a separate row beneath. -->
                                <Border Grid.Row="3" Margin="0,8,0,0" Padding="6,6" CornerRadius="8"
                                        Background="#121820" BorderBrush="#223040" BorderThickness="1">
                                    <StackPanel>
                                        <WrapPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Flat" Tag="Flat" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Flat"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Flat}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Bass" Tag="Bass" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Bass"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Bass}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Club" Tag="Club" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Club"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Club}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Rock" Tag="Rock" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Rock"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Rock}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Pop" Tag="Pop" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Pop"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Pop}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Live" Tag="Live" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Live"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Live}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Voice" Tag="Voice" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Voice"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Voice}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Bright" Tag="Bright" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Bright"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Bright}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Classical" Tag="Classical" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Classical"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Classical}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Soft" Tag="Soft" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Soft"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Soft}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Techno" Tag="Techno" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Techno"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Techno}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Acoustic" Tag="Acoustic" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Acoustic"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Acoustic}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Hip-Hop" Tag="Hip-Hop" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Hip-Hop"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Hip-Hop}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Jazz" Tag="Jazz" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Jazz"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Jazz}"/>
                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Dance" Tag="Dance" Margin="3"
                                                         GroupName="{Binding MasterEqPresetGroupToken}"
                                                         Command="{Binding ApplyMasterEqPresetCommand}" CommandParameter="Dance"
                                                         IsChecked="{Binding SelectedMasterEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Dance}"/>

                                            <!-- Custom slot 1. Same chip chrome as the built-ins so the strip
                                                 reads as one continuous row, but the Background flips to
                                                 SonicSecondary (green) when this slot is "dirty"
                                                 (SelectedMasterEqPresetKey == "Custom" AND live gains differ
                                                 from saved). Click recalls when clean, saves when dirty. -->
                                            <Button Margin="3" Command="{Binding ToggleCustomEq1Command}" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="ToolTip" Value="Click to recall your saved Custom 1 EQ curve."/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomEq1Dirty}" Value="True">
                                                                <Setter Property="ToolTip" Value="Click to save the current EQ curve into Custom 1."/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Outer" CornerRadius="6" Padding="8,5" BorderThickness="1" MinHeight="32" MinWidth="58">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <!-- Idle: same chrome as built-in chips at rest. -->
                                                                    <Setter Property="Background" Value="#1A1F26"/>
                                                                    <Setter Property="BorderBrush" Value="#2A323C"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedMasterEqPresetKey, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Custom1}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource SonicPrimaryBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource SonicPrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCustomEq1Dirty}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource SonicSecondaryBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource SonicSecondaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding CustomEq1ButtonContent}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#9CA8B3"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SelectedMasterEqPresetKey, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Custom1}" Value="True">
                                                                                <Setter Property="Foreground" Value="#0A1218"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCustomEq1Dirty}" Value="True">
                                                                                <Setter Property="Foreground" Value="#092100"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Custom slot 2. Independent dirty state from slot 1. -->
                                            <Button Margin="3" Command="{Binding ToggleCustomEq2Command}" Cursor="Hand">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="ToolTip" Value="Click to recall your saved Custom 2 EQ curve."/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCustomEq2Dirty}" Value="True">
                                                                <Setter Property="ToolTip" Value="Click to save the current EQ curve into Custom 2."/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Outer" CornerRadius="6" Padding="8,5" BorderThickness="1" MinHeight="32" MinWidth="58">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1A1F26"/>
                                                                    <Setter Property="BorderBrush" Value="#2A323C"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedMasterEqPresetKey, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Custom2}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource SonicPrimaryBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource SonicPrimaryBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCustomEq2Dirty}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource SonicSecondaryBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource SonicSecondaryBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding CustomEq2ButtonContent}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#9CA8B3"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding SelectedMasterEqPresetKey, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Custom2}" Value="True">
                                                                                <Setter Property="Foreground" Value="#0A1218"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCustomEq2Dirty}" Value="True">
                                                                                <Setter Property="Foreground" Value="#092100"/>
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Spatial pills row. Sits inside the master card so the user picks scene + EQ together. -->
                                <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
                                    <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                                     IsChecked="{Binding MasterSpatialActive, Mode=TwoWay}"
                                                     ToolTip="Master switch — spatial DSP off restores passthrough."/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource SonicOnSurfaceBrush}" Text="Spatial scene"/>
                                </DockPanel>

                                <!-- Single WrapPanel so all 7 spatial pills stay on one row when the
                                     master engine card is wide enough to hold them, and wrap to a
                                     second row only when the window narrows past their combined
                                     min-width. Pills size to content + padding (smaller font / tighter
                                     padding than before) so 7 of them fit comfortably across a
                                     typical 1100-1200px window. -->
                                <Border Grid.Row="5" Margin="0,8,0,0" Padding="6,6" CornerRadius="10"
                                        Background="#060A10" BorderBrush="#1F2C3F" BorderThickness="1">
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton Margin="3" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     Tag="HeadphoneStereoPlus" Content="Stereo +"
                                                     GroupName="{Binding MasterSpatialPresetGroupToken}"
                                                     IsChecked="{Binding MasterSpatialPreset, Mode=TwoWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=HeadphoneStereoPlus}"/>
                                        <RadioButton Margin="3" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     Tag="HeadphoneStudio" Content="Studio"
                                                     GroupName="{Binding MasterSpatialPresetGroupToken}"
                                                     IsChecked="{Binding MasterSpatialPreset, Mode=TwoWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=HeadphoneStudio}"/>
                                        <RadioButton Margin="3" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     Tag="HeadphoneCinema" Content="Cinema · 7.1"
                                                     GroupName="{Binding MasterSpatialPresetGroupToken}"
                                                     IsChecked="{Binding MasterSpatialPreset, Mode=TwoWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=HeadphoneCinema}"/>
                                        <RadioButton Margin="3" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     Tag="HeadphoneConcertHall" Content="Concert hall"
                                                     GroupName="{Binding MasterSpatialPresetGroupToken}"
                                                     IsChecked="{Binding MasterSpatialPreset, Mode=TwoWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=HeadphoneConcertHall}"/>
                                        <RadioButton Margin="3" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     Tag="Speakers_5_1" Content="5.1 speakers"
                                                     GroupName="{Binding MasterSpatialPresetGroupToken}"
                                                     IsChecked="{Binding MasterSpatialPreset, Mode=TwoWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=Speakers_5_1}"/>
                                        <RadioButton Margin="3" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     Tag="Speakers_7_1" Content="7.1 speakers"
                                                     GroupName="{Binding MasterSpatialPresetGroupToken}"
                                                     IsChecked="{Binding MasterSpatialPreset, Mode=TwoWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=Speakers_7_1}"/>
                                        <RadioButton Margin="3" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     Tag="GameMode" Content="Game"
                                                     GroupName="{Binding MasterSpatialPresetGroupToken}"
                                                     IsChecked="{Binding MasterSpatialPreset, Mode=TwoWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=GameMode}"/>
                                    </WrapPanel>
                                </Border>

                                <!-- Stereo width slider — first stage of every spatial preset chain.
                                     <1 narrows toward mono, 1.0 = pass-through, >1 widens.
                                     Greyed out when Spatial scene is Off (no pipeline running). -->
                                <Grid Grid.Row="6" Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Stereo width" Foreground="{StaticResource SonicOnSurfaceBrush}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   ToolTip="Mid/side scaling applied at the head of every Spatial scene chain. 1.0× passes audio through unchanged; values below 1.0× collapse toward mono; values above widen the stereo image. Has no effect when Spatial scene is Off."/>
                                        <Slider Grid.Column="1"
                                                Minimum="0.5" Maximum="1.6"
                                                TickFrequency="0.1" IsSnapToTickEnabled="False"
                                                SmallChange="0.02" LargeChange="0.1"
                                                Value="{Binding MasterStereoWidth, Mode=TwoWay}"
                                                IsEnabled="{Binding MasterSpatialActive}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MasterStereoWidth, StringFormat={}{0:F2}×}"
                                                   Foreground="{StaticResource SonicOnSurfaceBrush}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Width="52" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mono ←" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Left"/>
                                        <TextBlock Grid.Column="1" Text="Pass-through" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="→ Wide" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Virtual playback profiles — kept in the codebase but hidden in v1.
                             docs/AUDIO_BUS_PLAN.md: virtual endpoints are invisible plumbing; the
                             master engine + bus chip handle the user's mental model. -->
                        <StackPanel Visibility="Collapsed">
                            <TextBlock Text="VIRTUAL PLAYBACK PROFILES" Style="{StaticResource SonicSectionHeader}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding VirtualDevices}" Margin="0,0,0,24">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SonicSurfaceContainerBrush}" CornerRadius="14" BorderThickness="1" Margin="0,0,0,12">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource SonicPrimaryBrush}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                            <Setter Property="Background" Value="{StaticResource SonicSurfaceContainerHighBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <!-- Header -->
                                                <Grid Margin="18,16,14,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" BorderThickness="1" Margin="0,0,14,0" Background="#1A74D1FF" BorderBrush="#4D74D1FF">
                                                        <ui:SymbolIcon Symbol="Pulse24" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="20"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ProfileLabel}" Foreground="{StaticResource SonicPrimaryBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                            <Border Margin="10,0,0,0" Background="{StaticResource SonicSecondaryBrush}" CornerRadius="9" Padding="7,2" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="SYSTEM DEFAULT" Foreground="#092100" FontSize="9" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="#A8B8C4" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding DuplicateStatus}" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" Margin="0,4,0,0"/>
                                                    </StackPanel>

                                                    <ctrl:SpectrumMeter Grid.Column="2" Width="200" Height="44" Margin="14,0,14,0" Level="{Binding PeakValue}" IsActive="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}" BarCount="20"/>

                                                    <Button Grid.Column="3" Style="{StaticResource SonicIconFrameButton}" Margin="0,0,6,0" ToolTip="Set as default playback"
                                                            Command="{Binding DataContext.SetDefaultDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <ui:SymbolIcon Symbol="Star24" FontSize="16"/>
                                                    </Button>

                                                    <ToggleButton Grid.Column="4" Style="{StaticResource SonicIconFrameToggle}" IsChecked="{Binding IsAdvancedExpanded, Mode=TwoWay}" ToolTip="Profile routing, mirror, spatial &amp; EQ">
                                                        <ui:SymbolIcon Symbol="Settings24" FontSize="16"/>
                                                    </ToggleButton>
                                                </Grid>

                                                <!-- Volume -->
                                                <Grid Margin="18,0,18,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource SonicIconFrameButton}" Click="OnDeviceMuteClicked" Margin="0,0,10,0" Padding="8">
                                                        <ui:SymbolIcon FontSize="16">
                                                            <ui:SymbolIcon.Style>
                                                                <Style TargetType="ui:SymbolIcon">
                                                                    <Setter Property="Symbol" Value="Speaker224"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                            <Setter Property="Symbol" Value="SpeakerMute24"/>
                                                                            <Setter Property="Foreground" Value="#FF6F8A"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ui:SymbolIcon.Style>
                                                        </ui:SymbolIcon>
                                                    </Button>
                                                    <Slider Grid.Column="1" Style="{StaticResource SonicVolumeSlider}" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="1" IsEnabled="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}" ValueChanged="OnOutputDeviceVolumeChanged" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="SemiBold" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>

                                                <!-- Advanced -->
                                                <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Background="#101112" Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Margin="18,12,18,14">

                                                        <!-- Mirror on top (auto height); EQ 65* / spatial modes 35* below -->
                                                        <Border Margin="0,4,0,0" VerticalAlignment="Top" Padding="0" Background="Transparent" BorderThickness="0">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Border Grid.Row="0" CornerRadius="14" Padding="12,10" Margin="0,0,0,10"
                                                                        Background="#0A0F14" BorderBrush="#213040" BorderThickness="1">
                                                                    <DockPanel LastChildFill="True">
                                                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <ToggleButton Grid.Column="0" Margin="0,0,8,0" Width="34" Height="34" Padding="0"
                                                                                         Cursor="Hand" Background="#121820" BorderBrush="#2A3948"
                                                                                         BorderThickness="1" VerticalAlignment="Center"
                                                                                         IsChecked="{Binding MirrorOutputsListExpanded, Mode=TwoWay}">
                                                                                <ToggleButton.Style>
                                                                                    <Style TargetType="ToggleButton">
                                                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                                        <Setter Property="Template">
                                                                                            <Setter.Value>
                                                                                                <ControlTemplate TargetType="ToggleButton">
                                                                                                    <Border x:Name="B" CornerRadius="8" Padding="4"
                                                                                                            Background="{TemplateBinding Background}"
                                                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                                                                        <Grid>
                                                                                                            <ui:SymbolIcon x:Name="Chev"
                                                                                                                           Symbol="ChevronDown24" FontSize="15"
                                                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                                           Foreground="#9AABBC"/>
                                                                                                        </Grid>
                                                                                                    </Border>
                                                                                                    <ControlTemplate.Triggers>
                                                                                                        <Trigger Property="IsChecked" Value="False">
                                                                                                            <Setter TargetName="Chev" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                                                                            <Setter TargetName="Chev" Property="RenderTransform">
                                                                                                                <Setter.Value>
                                                                                                                    <RotateTransform Angle="-90"/>
                                                                                                                </Setter.Value>
                                                                                                            </Setter>
                                                                                                        </Trigger>
                                                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                                                            <Setter TargetName="B" Property="Background" Value="#1A2434"/>
                                                                                                        </Trigger>
                                                                                                    </ControlTemplate.Triggers>
                                                                                                </ControlTemplate>
                                                                                            </Setter.Value>
                                                                                        </Setter>
                                                                                    </Style>
                                                                                </ToggleButton.Style>
                                                                                <ToggleButton.ToolTip>Show or hide mirror targets</ToggleButton.ToolTip>
                                                                            </ToggleButton>
                                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                                                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                                                                           Foreground="{StaticResource SonicOnSurfaceBrush}" Text="Mirror outputs"
                                                                                           ToolTipService.ShowDuration="20000">
                                                                                    <TextBlock.ToolTip>
                                                                                        <ToolTip MaxWidth="320">
                                                                                            <TextBlock TextWrapping="Wrap" MaxWidth="320">
                                                                                            For this virtual profile only: duplicate sessions that clone app audio to ticked outputs (per-profile EQ/spatial on that mirror path). Real speakers and HDMI use the row chip labeled Active plus the header audio bus—those feed the master engine, not this toggle. Toggle the chevron to show or hide the checklist.</TextBlock>
                                                                                        </ToolTip>
                                                                                    </TextBlock.ToolTip>
                                                                                </TextBlock>
                                                                                    <TextBlock Margin="14,11,0,0" VerticalAlignment="Center"
                                                                                               FontSize="10" FontWeight="Normal"
                                                                                               Foreground="#72808F"
                                                                                               Text="{Binding DuplicateTargets.Count, Mode=OneWay, StringFormat={}{0} mirror target(s)}"/>
                                                                                </StackPanel>
                                                                            <ui:ToggleSwitch Grid.Column="2"
                                                                                             IsChecked="{Binding IsDuplicating, Mode=OneWay}"
                                                                                             IsEnabled="{Binding IsDuplicateBusy, Converter={StaticResource InverseBooleanConverter}}"
                                                                                             Click="OnDuplicateToggleClicked"
                                                                                             VerticalAlignment="Center"
                                                                                             Margin="10,0,0,0"/>
                                                                        </Grid>
                                                                            <Grid Grid.IsSharedSizeScope="True" Margin="0,2,0,0"
                                                                                  Visibility="{Binding MirrorOutputsListExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                    <RowDefinition Height="Auto"/>
                                                                                </Grid.RowDefinitions>
                                                                                <Border Grid.Row="0" CornerRadius="6" Margin="0,0,0,6" Padding="8,7,8,6"
                                                                                        Background="#0B1018" BorderBrush="#1E2936" BorderThickness="1">
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="M_ShChk"/>
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="M_ShIco"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="M_ShDly" MinWidth="148"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0">
                                                                                            <TextBlock Text="OUTPUT" Style="{StaticResource SonicSectionHeader}" Margin="0"/>
                                                                                            <TextBlock Text="Endpoints to mirror into" Margin="0,2,0,0" FontSize="9" Foreground="#5C6978"/>
                                                                                        </StackPanel>
                                                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                                            <TextBlock Text="SYNC DELAY" Style="{StaticResource SonicSectionHeader}" Margin="0" HorizontalAlignment="Center"/>
                                                                                            <TextBlock Text="ms offset" Margin="0,2,0,0" FontSize="9" Foreground="#5C6978" HorizontalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                    </Grid>
                                                                                </Border>
                                                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding DuplicateTargets}"
                                                                                              ItemTemplate="{StaticResource MirrorPlaybackTargetRow}"/>
                                                                            </Grid>
                                                                    </DockPanel>
                                                                </Border>

                                                                <Grid Grid.Row="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="65*"/>
                                                                        <ColumnDefinition Width="12"/>
                                                                        <ColumnDefinition Width="35*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0" CornerRadius="14" Padding="10,8"
                                                                            Background="#0A0F14" BorderBrush="#213040" BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>

                                                                            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                                                                <Border Width="28" Height="28" CornerRadius="8"
                                                                                        Background="#1A2530" BorderBrush="#334455" BorderThickness="1" VerticalAlignment="Center">
                                                                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="15" HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" Foreground="{StaticResource SonicPrimaryBrush}"/>
                                                                                </Border>
                                                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"
                                                                                           Foreground="{StaticResource SonicOnSurfaceBrush}" Text="Profile EQ"
                                                                                           ToolTipService.ShowDuration="25000">
                                                                                    <TextBlock.ToolTip>
                                                                                        <ToolTip MaxWidth="300">
                                                                                            <StackPanel>
                                                                                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,4">Profile equalizer</TextBlock>
                                                                                                <TextBlock TextWrapping="Wrap">10-band graphic EQ on the mirrored path only—enable Mirror outputs above to hear changes. Profiles store presets and bands separately.</TextBlock>
                                                                                            </StackPanel>
                                                                                        </ToolTip>
                                                                                    </TextBlock.ToolTip>
                                                                                </TextBlock>
                                                                            </StackPanel>

                                                                        <Grid Grid.Row="1" MinHeight="58" VerticalAlignment="Top">
                                                                            <UniformGrid Columns="10" VerticalAlignment="Top" Visibility="{Binding IsEqGraphVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand0, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="31" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand1, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="62" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand2, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="125" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand3, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="250" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand4, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="500" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand5, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="1k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand6, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="2k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand7, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="4k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand8, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="8k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                                <StackPanel Margin="0,0,1,0" VerticalAlignment="Top" HorizontalAlignment="Center">
                                                                                    <Slider Orientation="Vertical" Height="54" Minimum="-12" Maximum="12" Value="{Binding EqBand9, Mode=TwoWay}"
                                                                                            Foreground="{StaticResource SonicPrimaryBrush}" Background="#0FFFFFFF" HorizontalAlignment="Center"/>
                                                                                    <TextBlock Text="16k" Margin="0,3,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="7" HorizontalAlignment="Center"/>
                                                                                </StackPanel>
                                                                            </UniformGrid>

                                                                            <Border MinHeight="78" Margin="0,4,0,0" Background="#080A0F" CornerRadius="8" BorderBrush="#1A2838" BorderThickness="1"
                                                                                    VerticalAlignment="Stretch"
                                                                                    Visibility="{Binding IsEqGraphVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                <Grid>
                                                                                    <Polyline Points="0,72 26,62 52,52 72,54 104,74 138,92 154,74 174,62 206,74 246,92 260,74 290,74 320,60 360,70 400,80"
                                                                                              Stroke="{StaticResource SonicPrimaryBrush}" StrokeThickness="2" Opacity="0.75" Stretch="Fill" Margin="20,14,20,34"/>
                                                                                    <TextBlock Text="Response sketch" Foreground="{StaticResource SonicOutlineBrush}" FontSize="9"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Opacity="0.5"/>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Grid>

                                                                            <Border Grid.Row="2" Margin="0,6,0,0" Background="#121820" CornerRadius="8" Padding="6,5" BorderBrush="#223040" BorderThickness="1">
                                                                                <Grid VerticalAlignment="Center">
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                        <ColumnDefinition Width="*" MinWidth="52"/>
                                                                                        <ColumnDefinition Width="Auto"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Flat" Tag="Flat"
                                                                                                         GroupName="{Binding EqPresetSegmentGroupToken}" Click="OnEqPresetRadioClick"
                                                                                                         IsChecked="{Binding SelectedEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Flat}"/>
                                                                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Bass" Tag="Bass" Margin="4,0,0,0"
                                                                                                         GroupName="{Binding EqPresetSegmentGroupToken}" Click="OnEqPresetRadioClick"
                                                                                                         IsChecked="{Binding SelectedEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Bass}"/>
                                                                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Club" Tag="Club" Margin="4,0,0,0"
                                                                                                         GroupName="{Binding EqPresetSegmentGroupToken}" Click="OnEqPresetRadioClick"
                                                                                                         IsChecked="{Binding SelectedEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Club}"/>
                                                                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Rock" Tag="Rock" Margin="4,0,0,0"
                                                                                                         GroupName="{Binding EqPresetSegmentGroupToken}" Click="OnEqPresetRadioClick"
                                                                                                         IsChecked="{Binding SelectedEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Rock}"/>
                                                                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Pop" Tag="Pop" Margin="4,0,0,0"
                                                                                                         GroupName="{Binding EqPresetSegmentGroupToken}" Click="OnEqPresetRadioClick"
                                                                                                         IsChecked="{Binding SelectedEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Pop}"/>
                                                                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Live" Tag="Live" Margin="4,0,0,0"
                                                                                                         GroupName="{Binding EqPresetSegmentGroupToken}" Click="OnEqPresetRadioClick"
                                                                                                         IsChecked="{Binding SelectedEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Live}"/>
                                                                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Voice" Tag="Voice" Margin="4,0,0,0"
                                                                                                         GroupName="{Binding EqPresetSegmentGroupToken}" Click="OnEqPresetRadioClick"
                                                                                                         IsChecked="{Binding SelectedEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Voice}"/>
                                                                                            <RadioButton Style="{StaticResource SonicEqPresetRadioCompact}" Content="Techno" Tag="Techno" Margin="4,0,0,0"
                                                                                                         GroupName="{Binding EqPresetSegmentGroupToken}" Click="OnEqPresetRadioClick"
                                                                                                         IsChecked="{Binding SelectedEqPresetKey, Mode=OneWay, Converter={StaticResource EqPresetKeyMatchConverter}, ConverterParameter=Techno}"/>
                                                                                        </StackPanel>
                                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                                                                                            <ui:Button Content="Reset" Click="OnResetEq" Appearance="Secondary"
                                                                                                       Padding="7,3" MinHeight="26" MaxHeight="26" Margin="0,0,6,0"
                                                                                                       Background="#2B1618" BorderBrush="#6E3036" FontSize="10"
                                                                                                       Icon="ArrowSync24" ToolTip="Reset bands to flat (0 dB)"/>
                                                                                            <ToggleButton Style="{StaticResource SonicIconFrameToggle}" Height="26" Width="26"
                                                                                                          Padding="0" IsChecked="{Binding IsEqGraphVisible, Mode=TwoWay}"
                                                                                                          ToolTip="Response sketch preview" VerticalAlignment="Center">
                                                                                                <ui:SymbolIcon Symbol="Pulse24" FontSize="12"/>
                                                                                            </ToggleButton>
                                                                                        </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>

                                                                    <Border Grid.Column="2" VerticalAlignment="Stretch" CornerRadius="14" Padding="11,11"
                                                                            Background="#0B101A" BorderBrush="#3C5B7A" BorderThickness="1" ClipToBounds="True">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="*" MinHeight="0"/>
                                                                            </Grid.RowDefinitions>

                                                                            <DockPanel Grid.Row="0" Margin="0,0,0,11" LastChildFill="True">
                                                                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="9"
                                                                                        VerticalAlignment="Center"
                                                                                        Background="#1A74D1FF" BorderBrush="#5474D1FF" BorderThickness="1"
                                                                                        Margin="0,0,11,0">
                                                                                    <ui:SymbolIcon Symbol="SoundSource24" FontSize="18" HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center" Foreground="{StaticResource SonicPrimaryBrush}"/>
                                                                                </Border>
                                                                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                                                 IsChecked="{Binding IsSpatialPresetActive, Mode=TwoWay}"
                                                                                                 ToolTip="Master switch — spatial DSP off restores passthrough."/>
                                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                                                    <TextBlock Text="Spatial audio" FontSize="13" FontWeight="SemiBold"
                                                                                               Foreground="{StaticResource SonicOnSurfaceBrush}">
                                                                                        <TextBlock.ToolTip>
                                                                                            <ToolTip MaxWidth="300">
                                                                                                <TextBlock TextWrapping="Wrap" MaxWidth="300">
                                                                                                Tune movie / game / headphone space without a dropdown. Each pill lights up aqua when selected, mirroring EQ behavior.</TextBlock>
                                                                                            </ToolTip>
                                                                                        </TextBlock.ToolTip>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                            </DockPanel>

                                                                            <Border Grid.Row="1" Padding="8,5" CornerRadius="6" Margin="0,0,0,8"
                                                                                    Background="#1A2434" BorderBrush="#2C3E55" BorderThickness="1"
                                                                                    Visibility="{Binding IsDuplicating, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <Ellipse Width="6" Height="6" Fill="#74D1FF"
                                                                                             VerticalAlignment="Center" Margin="2,0,8,0"/>
                                                                                    <TextBlock VerticalAlignment="Center" FontSize="10.5"
                                                                                               Foreground="#9DB1C5" TextWrapping="Wrap">
                                                                                        Engages when <Run FontWeight="SemiBold" Foreground="{StaticResource SonicPrimaryBrush}">Mirror outputs</Run> is on.
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <Border Grid.Row="2" Padding="8,10" CornerRadius="10" Margin="0,0,0,0"
                                                                                    Background="#060A10" BorderBrush="#1F2C3F" BorderThickness="1">
                                                                                <Border.Style>
                                                                                    <Style TargetType="Border">
                                                                                        <Setter Property="Opacity" Value="1.0"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsDuplicating}" Value="False">
                                                                                                <Setter Property="Opacity" Value="0.55"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Border.Style>
                                                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                                                              HorizontalContentAlignment="Stretch">
                                                                                    <UniformGrid Columns="3" Rows="3" Margin="-2,-2,-2,0">
                                                                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                                                                     Tag="HeadphoneStereoPlus" Content="Stereo +" Click="OnSpatialPresetRadioClick"
                                                                                                     GroupName="{Binding SpatialPresetSegmentGroupToken}"
                                                                                                     ToolTip="Headphones with light cross-feed (no theatrical HRTF)."
                                                                                                     IsChecked="{Binding SpatialPreset, Mode=OneWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=HeadphoneStereoPlus}"/>
                                                                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                                                                     Tag="HeadphoneStudio" Content="Studio" Click="OnSpatialPresetRadioClick"
                                                                                                     GroupName="{Binding SpatialPresetSegmentGroupToken}"
                                                                                                     ToolTip="Dry-ish studio widening for mastering reference."
                                                                                                     IsChecked="{Binding SpatialPreset, Mode=OneWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=HeadphoneStudio}"/>
                                                                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                                                                     Tag="HeadphoneCinema" Content="Cinema · 7.1" Click="OnSpatialPresetRadioClick"
                                                                                                     GroupName="{Binding SpatialPresetSegmentGroupToken}"
                                                                                                     ToolTip="Theatrical 7.1-style layout dialed-in for headsets."
                                                                                                     IsChecked="{Binding SpatialPreset, Mode=OneWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=HeadphoneCinema}"/>
                                                                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                                                                     Tag="HeadphoneConcertHall" Content="Concert hall" Click="OnSpatialPresetRadioClick"
                                                                                                     GroupName="{Binding SpatialPresetSegmentGroupToken}"
                                                                                                     ToolTip="Large hall acoustics with 5.1 upmix cues."
                                                                                                     IsChecked="{Binding SpatialPreset, Mode=OneWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=HeadphoneConcertHall}"/>
                                                                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                                                                     Tag="Speakers_5_1" Content="5.1 speakers" Click="OnSpatialPresetRadioClick"
                                                                                                     GroupName="{Binding SpatialPresetSegmentGroupToken}"
                                                                                                     ToolTip="Physical 5.1 loudspeaker layouts with sane upmixing."
                                                                                                     IsChecked="{Binding SpatialPreset, Mode=OneWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=Speakers_5_1}"/>
                                                                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                                                                     Tag="Speakers_7_1" Content="7.1 speakers" Click="OnSpatialPresetRadioClick"
                                                                                                     GroupName="{Binding SpatialPresetSegmentGroupToken}"
                                                                                                     ToolTip="Physical 7.1 loudspeaker layouts with matrix upmix (see MatrixUpmixStage ordering)."
                                                                                                     IsChecked="{Binding SpatialPreset, Mode=OneWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=Speakers_7_1}"/>
                                                                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                                                                     Tag="GameMode" Content="Game" Click="OnSpatialPresetRadioClick"
                                                                                                     GroupName="{Binding SpatialPresetSegmentGroupToken}"
                                                                                                     ToolTip="Low-latency spatial trim for shooters and voice chat."
                                                                                                     IsChecked="{Binding SpatialPreset, Mode=OneWay, Converter={StaticResource SpatialPresetEnumMatchConverter}, ConverterParameter=GameMode}"/>
                                                                                    </UniformGrid>
                                                                                </ScrollViewer>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Hardware endpoints -->
                        <TextBlock Text="HARDWARE PLAYBACK DEVICES" Style="{StaticResource SonicSectionHeader}" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding PhysicalDevices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Two cards per row. UniformGrid drops to one column automatically when the
                                         window is too narrow because each card has Margin so they wrap visually. -->
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SonicSurfaceContainerBrush}" CornerRadius="14" BorderThickness="1" Margin="0,0,8,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource SonicPrimaryBrush}"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                        <Setter Property="Background" Value="{StaticResource SonicSurfaceContainerHighBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Grid Margin="14,12,10,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" BorderThickness="1" Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1B1D20"/>
                                                            <Setter Property="BorderBrush" Value="#262A2F"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                    <Setter Property="Background" Value="#1A74D1FF"/>
                                                                    <Setter Property="BorderBrush" Value="#4D74D1FF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="16">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Foreground" Value="{StaticResource SonicOutlineBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SonicPrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="240"
                                                                   ToolTip="{Binding Name}"/>
                                                        <Border Margin="10,0,0,0" Background="{StaticResource SonicSecondaryBrush}" CornerRadius="9" Padding="7,2"
                                                                Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="DEFAULT" Foreground="#092100" FontSize="9" FontWeight="Bold"/>
                                                        </Border>

                                                        <Border Margin="8,0,0,0" Background="#1A2434" BorderBrush="#2C3E55"
                                                                BorderThickness="1" CornerRadius="9" Padding="7,2"
                                                                ToolTip="{Binding TargetLatencyOffsetMs, StringFormat='Default sync offset for this class: {0} ms'}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DeviceClassLabel}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding DeviceClassLabel}" Foreground="#9DB1C5" FontSize="9" FontWeight="Bold"/>
                                                        </Border>

                                                        <ToggleButton Margin="10,0,0,0" Padding="9,3"
                                                                      IsChecked="{Binding IsActiveOutput, Mode=TwoWay}" Cursor="Hand"
                                                                      ToolTip="When the bus is on, ACTIVE outputs receive the master-processed mirror."
                                                                      VerticalAlignment="Center">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border x:Name="ChipBg" CornerRadius="9"
                                                                                        Background="#262A2F" BorderBrush="#3B4148" BorderThickness="1"
                                                                                        Padding="{TemplateBinding Padding}">
                                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                                                            <Ellipse.Style>
                                                                                                <Style TargetType="Ellipse">
                                                                                                    <Setter Property="Fill" Value="#586470"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsActiveOutput}" Value="True">
                                                                                                            <Setter Property="Fill" Value="{StaticResource SonicSecondaryBrush}"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Ellipse.Style>
                                                                                        </Ellipse>
                                                                                        <TextBlock VerticalAlignment="Center" FontSize="9" FontWeight="Bold">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Text" Value="OFF"/>
                                                                                                    <Setter Property="Foreground" Value="#7F8893"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsActiveOutput}" Value="True">
                                                                                                            <Setter Property="Text" Value="ACTIVE"/>
                                                                                                            <Setter Property="Foreground" Value="#092100"/>
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="ChipBg" Property="Background" Value="{StaticResource SonicSecondaryBrush}"/>
                                                                                        <Setter TargetName="ChipBg" Property="BorderBrush" Value="{StaticResource SonicSecondaryBrush}"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="ChipBg" Property="BorderBrush" Value="#5C6671"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>
                                                    </StackPanel>
                                                </StackPanel>

                                                <ctrl:SpectrumMeter Grid.Column="2" Width="120" Height="32" Margin="8,0,8,0"
                                                                    Level="{Binding PeakValue}"
                                                                    IsActive="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}"
                                                                    BarCount="14"
                                                                    ToolTip="Live output level for this device"/>

                                                <!-- Dual-mode star button. Always visible:
                                                       Bus OFF → Set as Windows default playback (Star icon, filled blue when this device IS the default).
                                                       Bus ON  → Toggle ACTIVE on the bridge fan-out (Speaker icon, filled green when this device is ACTIVE).
                                                     A single click never disappears the button or routes audio away from the bridge by accident. -->
                                                <Button Grid.Column="3" Margin="0,0,0,0"
                                                        Command="{Binding DataContext.DeviceStarToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SonicIconFrameButton}">
                                                            <Setter Property="ToolTip" Value="Set as default Windows playback device."/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.Power.IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="ToolTip" Value="Application is ON — click to include or exclude this device from the master bridge fan-out (ACTIVE on/off). When green, this output receives the processed audio."/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <ui:SymbolIcon FontSize="16">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <!-- Default state (bus off, not default): hollow star, dim. -->
                                                                <Setter Property="Symbol" Value="Star24"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SonicOutlineBrush}"/>
                                                                <Style.Triggers>
                                                                    <!-- Bus off, IS default: filled star, primary blue. -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DataContext.Power.IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                                            <Condition Binding="{Binding IsDefault}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Symbol" Value="Star24"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource SonicPrimaryBrush}"/>
                                                                    </MultiDataTrigger>
                                                                    <!-- Bus on, NOT active: hollow speaker, dim. -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DataContext.Power.IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                            <Condition Binding="{Binding IsActiveOutput}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Symbol" Value="Speaker224"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource SonicOutlineBrush}"/>
                                                                    </MultiDataTrigger>
                                                                    <!-- Bus on, IS active: filled speaker, secondary green. -->
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DataContext.Power.IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                            <Condition Binding="{Binding IsActiveOutput}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Symbol" Value="Speaker224"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource SonicSecondaryBrush}"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Button>
                                            </Grid>

                                            <!-- Optional re-calibration / drift / auto-sync banner.
                                                 Each child is collapsed by default; it expands only when its
                                                 own visibility data trigger fires, so the row is invisible most
                                                 of the time and doesn't waste vertical space. -->
                                            <StackPanel Orientation="Horizontal" Margin="14,0,14,4">
                                                <ui:Button Margin="0,0,8,0" Padding="6,2" FontSize="9" Appearance="Transparent"
                                                           Content="RE-CAL?"
                                                           Visibility="{Binding SyncCalibrationStale, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           ToolTip="Your last Sync wizard run used a different mix format than Windows is using now. Click to open the Sync wizard."
                                                           VerticalAlignment="Center"
                                                           Command="{Binding DataContext.OpenSyncCalibrationWizardCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <ui:Button Margin="0,0,8,0" Padding="6,2" FontSize="9" Appearance="Transparent"
                                                           Content="DRIFT?"
                                                           Visibility="{Binding AutoSyncDrift, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           ToolTip="Mix format changed since the last Auto-sync. Click to re-run."
                                                           VerticalAlignment="Center"
                                                           Command="{Binding DataContext.OpenAutoSyncWizardCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                <TextBlock FontSize="9" Foreground="#74D1FF" VerticalAlignment="Center"
                                                           Text="{Binding AutoSyncCaption}"
                                                           Visibility="{Binding HasAutoSyncCaption, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           ToolTip="Last mic-based auto-sync calibration timestamp for this output."/>
                                            </StackPanel>

                                            <!-- Volume + Sync inline. Single row keeps each device card tight:
                                                 [mute] [volume slider] [%] | [sync icon] [sync slider] [ms]
                                                 Each control has a tooltip explaining its role. -->
                                            <Grid Margin="14,0,14,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource SonicIconFrameButton}" Click="OnDeviceMuteClicked" Margin="0,0,6,0" Padding="6"
                                                        ToolTip="Mute / unmute this device">
                                                    <ui:SymbolIcon FontSize="14">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Speaker224"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                        <Setter Property="Symbol" Value="SpeakerMute24"/>
                                                                        <Setter Property="Foreground" Value="#FF6F8A"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                </Button>
                                                <Slider Grid.Column="1" Style="{StaticResource SonicVolumeSlider}" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="1" IsEnabled="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}" ValueChanged="OnOutputDeviceVolumeChanged" VerticalAlignment="Center"
                                                        ToolTip="Output volume for this device (independent of Windows volume)"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="10" FontWeight="SemiBold" Width="32" TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                                <!-- Sync offset (per-target latency). 0–120 ms range for L1 baseline. -->
                                                <ui:SymbolIcon Grid.Column="4" Symbol="Timer24" FontSize="14"
                                                               Foreground="{StaticResource SonicOutlineBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                               ToolTip="Sync delay — adds latency before this output. Use to keep multiple speakers playing in time. 0 ms = no delay."/>
                                                <Slider Grid.Column="5"
                                                        Minimum="0" Maximum="120"
                                                        TickFrequency="10" IsSnapToTickEnabled="False"
                                                        SmallChange="1" LargeChange="5"
                                                        Value="{Binding TargetLatencyOffsetMs, Mode=TwoWay}"
                                                        IsEnabled="{Binding IsActiveOutput}"
                                                        ToolTip="Drag to add latency before this device plays the master mix. Greyed out when this output is not ACTIVE."
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding TargetLatencyOffsetMs, StringFormat={}{0} ms}"
                                                           Foreground="{StaticResource SonicOnSurfaceBrush}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Width="44" TextAlignment="Right"
                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Applications}">
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Per-app routing" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Pick an output device for each running app—the same logical step as assigning an app to a cable or profile in simpler tools." Foreground="{StaticResource SonicOutlineBrush}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:Button Content="Refresh list" Icon="ArrowSync24" HorizontalAlignment="Right" Appearance="Secondary"
                                       Command="{Binding RefreshDataCommand}"
                                       Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                        </Grid>

                        <!-- Master output strip: mute and volume for the system default device.
                             Visible on the Applications page so per-app routing has a global level
                             control next to it without forcing the user to switch tabs. -->
                        <Border Style="{StaticResource SonicCard}" Padding="16,12" Margin="0,0,0,16"
                                DataContext="{Binding MasterDevice}"
                                Visibility="{Binding ., Converter={StaticResource NullToCollapsedConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19"
                                        Background="#1A74D1FF" BorderBrush="#4D74D1FF" BorderThickness="1" Margin="0,0,12,0">
                                    <ui:SymbolIcon Symbol="Speaker224" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="18"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="Windows default playback" Foreground="{StaticResource SonicOutlineBrush}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                </StackPanel>

                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0"
                                            Style="{StaticResource SonicIconFrameButton}"
                                            Click="OnMasterMuteClicked"
                                            Margin="0,0,10,0"
                                            Padding="8"
                                            ToolTip="Mute every output device">
                                        <ui:SymbolIcon FontSize="16">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Speaker224"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SonicOnSurfaceBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Symbol" Value="SpeakerMute24"/>
                                                            <Setter Property="Foreground" Value="#FF6F8A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Button>
                                    <Slider Grid.Column="1"
                                            Style="{StaticResource SonicVolumeSlider}"
                                            Value="{Binding Volume, Mode=TwoWay}"
                                            Minimum="0" Maximum="1"
                                            IsEnabled="{Binding IsMuted, Converter={StaticResource InverseBooleanConverter}}"
                                            ValueChanged="OnMasterVolumeChanged"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="SemiBold" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Guide when nothing is exposing a session -->
                        <Border Margin="0,0,0,24" Padding="32,28" CornerRadius="12" Background="{StaticResource SonicSurfaceContainerBrush}" BorderBrush="#263038" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveSessions}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                                <ui:SymbolIcon Symbol="Speaker224" Foreground="{StaticResource SonicOutlineBrush}" FontSize="36" Margin="0,0,0,14" HorizontalAlignment="Center"/>
                                <TextBlock Text="No apps with visible audio sessions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SonicOnSurfaceBrush}" TextAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                                           Foreground="{StaticResource SonicOutlineBrush}" FontSize="13">
                                    Start playback in a browser, media player, or game, then press <Run FontWeight="SemiBold" Foreground="#9CA8B0">Refresh list</Run>. Routed apps appear here when Windows reports an active audio session for that process.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,0,0,48">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveSessions}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SonicCard}" Width="316" Margin="0,0,16,18" Padding="18" MinHeight="300">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="#141A1F" BorderBrush="#22303A" BorderThickness="1" Margin="0,0,12,0">
                                                    <ui:SymbolIcon Symbol="Apps24" Foreground="{StaticResource SonicPrimaryBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessName}" Foreground="White" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}'}" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <ui:Button Grid.Column="2" Icon="ArrowSync24" Command="{Binding DataContext.RefreshDataCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Appearance="Transparent" Foreground="{StaticResource SonicOutlineBrush}" Padding="4"
                                                           ToolTip="Reload app list"/>
                                            </Grid>

                                            <Grid Height="42" Margin="0,0,0,16">
                                                <Border Background="#0CFFFFFF" CornerRadius="10" BorderBrush="#12FFFFFF" BorderThickness="1"/>
                                                <ctrl:SpectrumMeter Margin="8,7,8,7"
                                                                    Level="{Binding PeakValue}"
                                                                    IsActive="{Binding IsPlaying}"
                                                                    BarCount="14"/>
                                            </Grid>

                                            <StackPanel Margin="0,0,0,16">
                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="VOLUME" Foreground="{StaticResource SonicOutlineBrush}" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Volume, StringFormat={}{0:P0}}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Slider Style="{StaticResource SonicSlider}" ToolTip="App session volume" Value="{Binding Volume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False"/>
                                            </StackPanel>

                                            <TextBlock Text="Play on this device" Margin="0,2,0,8" Style="{StaticResource SonicSectionHeader}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Grid.Column="0"
                                                          Style="{StaticResource SonicComboBoxDeviceList}"
                                                          ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding SelectedTargetDevice, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"
                                                          ToolTip="Windows playback device for this app. Virtual endpoints use Profile N - friendly name format."/>
                                                <ui:Button Grid.Column="1"
                                                           Content="Route"
                                                           Command="{Binding DataContext.RouteAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Margin="10,0,0,0"
                                                           Appearance="Primary"
                                                           Padding="16,8"
                                                           ToolTip="Apply device choice and reopen the app’s playback client"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Microphones}">
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="Recording — capture devices" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Everything Windows reports as an input endpoint (similar to VB-CABLE showing cable inputs)." Foreground="{StaticResource SonicOutlineBrush}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ui:Button Content="Refresh list" Icon="Mic24" HorizontalAlignment="Right" Appearance="Secondary"
                                       Command="{Binding RefreshDataCommand}"
                                       Background="{StaticResource SonicSurfaceContainerHighBrush}" BorderBrush="#1AFFFFFF"/>
                        </Grid>

                        <!-- Voice studio card: routes a real mic through the SonicFlow voice chain into a
                             render endpoint (typically CABLE-B Input). See docs/MIC_CHAIN_PLAN.md. -->
                        <Border Style="{StaticResource SonicCard}" Padding="22" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Voice studio" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="Pipe a real mic through SonicFlow's voice chain (noise gate today; voice EQ &amp; limiter coming) into a render endpoint. Apps then pick that endpoint as their input — typically CABLE-B Output."/>
                                    </StackPanel>
                                    <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Command="{Binding MicChain.TogglePowerCommand}"
                                               IsEnabled="{Binding MicChain.CanPower}"
                                               Icon="Mic24"
                                               Appearance="Secondary"
                                               MinWidth="120" MinHeight="32" Padding="12,6">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Engage"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MicChain.IsPowered}" Value="True">
                                                        <Setter Property="Content" Value="Disengage"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Microphone source" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding MicChain.AvailableMics}"
                                                  SelectedItem="{Binding MicChain.SelectedMic, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Render to (virtual mic)" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding MicChain.AvailableRenderTargets}"
                                                  SelectedItem="{Binding MicChain.SelectedRender, Mode=TwoWay}"
                                                  DisplayMemberPath="Name"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Voice preset (unified): row 1 is "tone" (EQ-only), row 2 is "character" (full macro: EQ + pitch + gate).
                                     Picking None acts as a real reset for the row — restores EQ Off, pitch 0, and default gate.
                                     Touching any slider afterwards clears the highlighted pill back to "no preset". -->
                                <TextBlock Text="Voice preset" Foreground="{StaticResource SonicOutlineBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                           ToolTip="Top row = EQ flavours (no pitch change). Bottom row = full character macros (EQ + pitch + gate). None resets the row. Touching a slider clears the highlighted pill."/>
                                <Border Margin="0,0,0,14" Padding="6,6" CornerRadius="10"
                                        Background="#060A10" BorderBrush="#1F2C3F" BorderThickness="1">
                                    <UniformGrid Columns="5" Rows="2" Margin="-2,-2,-2,-2">
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="None" Content="None" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=None}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Bright" Content="Bright" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Bright}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Warm" Content="Warm" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Warm}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Radio" Content="Radio" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Radio}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Telephone" Content="Telephone" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Telephone}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Robot" Content="Robot" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Robot}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Girl1" Content="Girl 1" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Girl1}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Girl2" Content="Girl 2" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Girl2}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Deep" Content="Deep" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Deep}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainVoicePreset" Tag="Chipmunk" Content="Chipmunk" Click="OnVoicePresetRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedVoicePreset, Mode=OneWay, Converter={StaticResource VoicePresetEnumMatchConverter}, ConverterParameter=Chipmunk}"/>
                                    </UniformGrid>
                                </Border>

                                <!-- Studio polish: compressor + de-esser bundle.
                                     Soft = gentle, Strong = studio voice, Broadcast = radio/podcast feel. -->
                                <TextBlock Text="Studio polish" Foreground="{StaticResource SonicOutlineBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                           ToolTip="One-click compressor + de-esser presets. Soft = gentle, Strong = studio voice, Broadcast = radio/podcast."/>
                                <Border Margin="0,0,0,12" Padding="6,6" CornerRadius="10"
                                        Background="#060A10" BorderBrush="#1F2C3F" BorderThickness="1">
                                    <UniformGrid Columns="4" Rows="1" Margin="-2,-2,-2,-2">
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainPolish" Tag="None" Content="None" Click="OnStudioPolishRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedStudioPolish, Mode=OneWay, Converter={StaticResource StudioPolishPresetEnumMatchConverter}, ConverterParameter=None}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainPolish" Tag="Soft" Content="Soft" Click="OnStudioPolishRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedStudioPolish, Mode=OneWay, Converter={StaticResource StudioPolishPresetEnumMatchConverter}, ConverterParameter=Soft}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainPolish" Tag="Strong" Content="Strong" Click="OnStudioPolishRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedStudioPolish, Mode=OneWay, Converter={StaticResource StudioPolishPresetEnumMatchConverter}, ConverterParameter=Strong}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainPolish" Tag="Broadcast" Content="Broadcast" Click="OnStudioPolishRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedStudioPolish, Mode=OneWay, Converter={StaticResource StudioPolishPresetEnumMatchConverter}, ConverterParameter=Broadcast}"/>
                                    </UniformGrid>
                                </Border>

                                <!-- Reverb: Freeverb-style Schroeder reverb. None bypasses the stage entirely.
                                     Picks add ambience after the chain so the limiter still catches reverb peaks. -->
                                <TextBlock Text="Reverb" Foreground="{StaticResource SonicOutlineBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                           ToolTip="Adds room ambience to your voice. None = bypassed. Voice booth is barely-there air; Cathedral is dramatic long tail."/>
                                <Border Margin="0,0,0,14" Padding="6,6" CornerRadius="10"
                                        Background="#060A10" BorderBrush="#1F2C3F" BorderThickness="1">
                                    <UniformGrid Columns="6" Rows="1" Margin="-2,-2,-2,-2">
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainReverb" Tag="None" Content="None" Click="OnReverbRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedReverb, Mode=OneWay, Converter={StaticResource ReverbPresetEnumMatchConverter}, ConverterParameter=None}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainReverb" Tag="VoiceBooth" Content="Booth" Click="OnReverbRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedReverb, Mode=OneWay, Converter={StaticResource ReverbPresetEnumMatchConverter}, ConverterParameter=VoiceBooth}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainReverb" Tag="VocalPlate" Content="Plate" Click="OnReverbRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedReverb, Mode=OneWay, Converter={StaticResource ReverbPresetEnumMatchConverter}, ConverterParameter=VocalPlate}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainReverb" Tag="StudioRoom" Content="Room" Click="OnReverbRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedReverb, Mode=OneWay, Converter={StaticResource ReverbPresetEnumMatchConverter}, ConverterParameter=StudioRoom}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainReverb" Tag="ConcertHall" Content="Hall" Click="OnReverbRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedReverb, Mode=OneWay, Converter={StaticResource ReverbPresetEnumMatchConverter}, ConverterParameter=ConcertHall}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainReverb" Tag="Cathedral" Content="Cathedral" Click="OnReverbRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedReverb, Mode=OneWay, Converter={StaticResource ReverbPresetEnumMatchConverter}, ConverterParameter=Cathedral}"/>
                                    </UniformGrid>
                                </Border>

                                <!-- Noise reduction: spectral subtraction. Off bypasses the FFT entirely.
                                     Sits at the head of the chain so the gate / EQ / compressor see a cleaner signal. -->
                                <TextBlock Text="Noise reduction" Foreground="{StaticResource SonicOutlineBrush}"
                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"
                                           ToolTip="Continuous noise suppressor. Light removes faint room hum; Strong is for noisy environments but may add slight artifacts on consonants."/>
                                <Border Margin="0,0,0,12" Padding="6,6" CornerRadius="10"
                                        Background="#060A10" BorderBrush="#1F2C3F" BorderThickness="1">
                                    <UniformGrid Columns="4" Rows="1" Margin="-2,-2,-2,-2">
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainNoiseReduction" Tag="Off" Content="Off" Click="OnNoiseReductionRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedNoiseReduction, Mode=OneWay, Converter={StaticResource NoiseReductionPresetEnumMatchConverter}, ConverterParameter=Off}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainNoiseReduction" Tag="Light" Content="Light" Click="OnNoiseReductionRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedNoiseReduction, Mode=OneWay, Converter={StaticResource NoiseReductionPresetEnumMatchConverter}, ConverterParameter=Light}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainNoiseReduction" Tag="Medium" Content="Medium" Click="OnNoiseReductionRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedNoiseReduction, Mode=OneWay, Converter={StaticResource NoiseReductionPresetEnumMatchConverter}, ConverterParameter=Medium}"/>
                                        <RadioButton Margin="4" HorizontalAlignment="Stretch" Style="{StaticResource SonicSpatialPresetListRadio}"
                                                     GroupName="MicChainNoiseReduction" Tag="Strong" Content="Strong" Click="OnNoiseReductionRadioClick"
                                                     IsChecked="{Binding MicChain.SelectedNoiseReduction, Mode=OneWay, Converter={StaticResource NoiseReductionPresetEnumMatchConverter}, ConverterParameter=Strong}"/>
                                    </UniformGrid>
                                </Border>

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Noise gate" Foreground="{StaticResource SonicOutlineBrush}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button Content="Reset" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Command="{Binding MicChain.ResetGateCommand}"
                                               Appearance="Secondary" MinHeight="24" Padding="10,2" FontSize="10"
                                               ToolTip="Restore gate threshold = -40 dBFS, gate hold = 80 ms"/>
                                </Grid>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Threshold" Foreground="{StaticResource SonicOutlineBrush}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="1" Minimum="-80" Maximum="0"
                                            TickFrequency="5" SmallChange="1" LargeChange="5"
                                            Value="{Binding MicChain.GateThresholdDb, Mode=TwoWay}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MicChain.GateThresholdDb, StringFormat={}{0:F0} dBFS}"
                                               Foreground="{StaticResource SonicOnSurfaceBrush}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Width="64" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hold" Foreground="{StaticResource SonicOutlineBrush}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="500"
                                            TickFrequency="20" SmallChange="5" LargeChange="20"
                                            Value="{Binding MicChain.GateHoldMs, Mode=TwoWay}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MicChain.GateHoldMs, StringFormat={}{0:F0} ms}"
                                               Foreground="{StaticResource SonicOnSurfaceBrush}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Width="64" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pitch" Foreground="{StaticResource SonicOutlineBrush}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                               ToolTip="Pitch shift in semitones (tempo preserved). 0 = bypass; positive = higher voice; negative = deeper voice."/>
                                    <Slider Grid.Column="1" Minimum="-12" Maximum="12"
                                            TickFrequency="1" SmallChange="0.5" LargeChange="1"
                                            Value="{Binding MicChain.PitchSemitones, Mode=TwoWay}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MicChain.PitchSemitones, StringFormat={}{0:+0.0;-0.0;0} st}"
                                               Foreground="{StaticResource SonicOnSurfaceBrush}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Width="64" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Input level" Foreground="{StaticResource SonicOutlineBrush}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Grid.Column="1" Height="8" Background="#0FFFFFFF" CornerRadius="4" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Border Background="{StaticResource SonicPrimaryBrush}" CornerRadius="4" HorizontalAlignment="Left"
                                                    Width="{Binding MicChain.InputPeak, Converter={StaticResource PeakToHeightConverter}, ConverterParameter=320}"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Output level" Foreground="{StaticResource SonicOutlineBrush}"
                                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"
                                               ToolTip="Post-chain peak (after EQ, gate, limiter). Should land below the right edge — if it pins, lower the gate threshold or pick a tamer EQ preset."/>
                                    <Border Grid.Column="1" Height="8" Background="#0FFFFFFF" CornerRadius="4" HorizontalAlignment="Stretch">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Border Background="#FFB48A" CornerRadius="4" HorizontalAlignment="Left"
                                                    Width="{Binding MicChain.OutputPeak, Converter={StaticResource PeakToHeightConverter}, ConverterParameter=320}"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock Margin="0,12,0,0" FontSize="11"
                                           Foreground="{StaticResource SonicOutlineBrush}"
                                           Text="{Binding MicChain.StatusMessage}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,20" Padding="28,26" CornerRadius="12" Background="{StaticResource SonicSurfaceContainerBrush}" BorderBrush="#263038" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnyMicrophones}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                                <ui:SymbolIcon Symbol="Mic24" Foreground="{StaticResource SonicOutlineBrush}" FontSize="36" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                                <TextBlock Text="No capture devices detected" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SonicOnSurfaceBrush}" TextAlignment="Center"/>
                                <TextBlock Text="Plug in a headset or microphone, install drivers if needed, then refresh the list." TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,10,0,0" Foreground="{StaticResource SonicOutlineBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Microphones}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasAnyMicrophones}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SonicCard}" Padding="18" Margin="0,0,16,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="54" Height="54" Background="#1E2B34" BorderBrush="#36586D" BorderThickness="1" CornerRadius="14" Margin="0,0,16,0">
                                                <ui:SymbolIcon Symbol="Mic24" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="22"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="Input ready for monitoring and future routing tools." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,4,0,8"/>
                                                <Border Width="140" Height="6" Background="#0FFFFFFF" CornerRadius="4">
                                                    <Border Background="{Binding IsDefault, Converter={StaticResource ActivityBrushConverter}}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding Volume, Converter={StaticResource PeakToHeightConverter}, ConverterParameter=140}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Visibility="{Binding CurrentSection, Converter={StaticResource SectionVisibilityConverter}, ConverterParameter=Tools}">
                        <Grid Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Tools &amp; diagnostics" Foreground="{StaticResource SonicOnSurfaceBrush}" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock Text="Test signals and quick sanity checks—the bottom of the control-panel flow." Foreground="{StaticResource SonicOutlineBrush}" FontSize="13" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="2">
                            <!-- Test Signal Card -->
                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Audio Test Signal" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Uses BASS to verify high-end audio path &amp; DLLs." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="MusicNote224" Foreground="{StaticResource SonicPrimaryBrush}" FontSize="24"/>
                                    </Grid>
                                    
                                    <ui:Button Command="{Binding ToggleTestToneCommand}" Padding="20,10" HorizontalAlignment="Left">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Start Test Tone"/>
                                                <Setter Property="Appearance" Value="Primary"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTestTonePlaying}" Value="True">
                                                        <Setter Property="Content" Value="Stop Test Tone"/>
                                                        <Setter Property="Appearance" Value="Secondary"/>
                                                        <Setter Property="Background" Value="#2B1618"/>
                                                        <Setter Property="BorderBrush" Value="#6E3036"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>
                                </StackPanel>
                            </Border>

                            <!-- Diagnostic Card -->
                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="Engine Diagnostics" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Run integrity checks on EQ filters and device enumeration. Use Diagnose Audio to dump bridge / EQ / spatial state to Debug Output when reporting an audio issue." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,8,0,16" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Button Content="Run Core Tests" Click="OnRunDiagnostics" Appearance="Secondary" Padding="14,8" Margin="0,0,8,0"/>
                                        <ui:Button Content="Diagnose Audio" Command="{Binding DiagnoseAudioCommand}" Appearance="Secondary" Padding="14,8" Margin="0,0,8,0"
                                                   ToolTip="Dump BASS bridge + master EQ + spatial state to Debug Output. Open Visual Studio Output (Debug) to see it."/>
                                        <ui:Button Content="EQ Kill 50%" Command="{Binding ToggleEqKillTestCommand}" Appearance="Secondary" Padding="14,8"
                                                   ToolTip="Toggles a 50% volume cut on the master EQ DSP. If you hear the volume drop, our DSP path reaches the speakers and the EQ math is the issue. If you don't, the DSP is attached to the wrong channel."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="Quick Refresh" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Reload sessions, outputs, and microphone devices." Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,8,0,16"/>
                                    <ui:Button Content="Refresh All Devices" Command="{Binding RefreshDataCommand}" Appearance="Secondary" Padding="14,8"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="BASS Integration" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Researching high-end BASS library for professional 7.1/Atmos sync." Foreground="{StaticResource SonicOutlineBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,8,0,16">
                            <StackPanel>
                                <TextBlock Text="Default Sync by device class (L1/L4)" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SonicOutlineBrush}" FontSize="12" Margin="0,8,0,12"
                                           Text="Baseline Sync slider for new Windows endpoints only (after L4 name presets). Per-device overrides stay in settings.json; use Refresh after plugging hardware to pick up seeds for brand-new ids."/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="On-board" VerticalAlignment="Center" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <Slider Grid.Row="0" Grid.Column="1" Margin="10,6,10,6" Style="{StaticResource SonicVolumeSlider}"
                                            Minimum="0" Maximum="120" SmallChange="1" LargeChange="5"
                                            Value="{Binding LatencyDefaultOnBoardMs, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LatencyDefaultOnBoardMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="USB" VerticalAlignment="Center" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <Slider Grid.Row="1" Grid.Column="1" Margin="10,6,10,6" Style="{StaticResource SonicVolumeSlider}"
                                            Minimum="0" Maximum="120" SmallChange="1" LargeChange="5"
                                            Value="{Binding LatencyDefaultUsbMs, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LatencyDefaultUsbMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="HDMI" VerticalAlignment="Center" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <Slider Grid.Row="2" Grid.Column="1" Margin="10,6,10,6" Style="{StaticResource SonicVolumeSlider}"
                                            Minimum="0" Maximum="120" SmallChange="1" LargeChange="5"
                                            Value="{Binding LatencyDefaultHdmiMs, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LatencyDefaultHdmiMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Bluetooth" VerticalAlignment="Center" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <Slider Grid.Row="3" Grid.Column="1" Margin="10,6,10,6" Style="{StaticResource SonicVolumeSlider}"
                                            Minimum="0" Maximum="120" SmallChange="1" LargeChange="5"
                                            Value="{Binding LatencyDefaultBtMs, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LatencyDefaultBtMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Network" VerticalAlignment="Center" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <Slider Grid.Row="4" Grid.Column="1" Margin="10,6,10,6" Style="{StaticResource SonicVolumeSlider}"
                                            Minimum="0" Maximum="120" SmallChange="1" LargeChange="5"
                                            Value="{Binding LatencyDefaultNetworkMs, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LatencyDefaultNetworkMs, StringFormat={}{0} ms}" VerticalAlignment="Center" Foreground="White" FontSize="11" FontWeight="SemiBold" TextAlignment="Right"/>
                                </Grid>
                                <ui:Button Content="Reset to built-in class values" Appearance="Secondary" Margin="0,14,0,0" HorizontalAlignment="Left" Padding="14,8"
                                           Command="{Binding ResetLatencyClassDefaultsToBuiltInCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SonicCard}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Multichannel bridge (experimental)" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <CheckBox Margin="0,10,0,0"
                                          Content="Matrix surround upmix on 5.1 / 7.1 outputs @ 48 kHz"
                                          IsChecked="{Binding MatrixSurroundBridgeUpmix, Mode=TwoWay}"
                                          Foreground="#DDE3EA" FontSize="12"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" Margin="0,12,0,4"
                                           Text="7.1 channel order on HDMI / WASAPI"/>
                                <ComboBox Margin="0,0,0,0"
                                          SelectedValue="{Binding MatrixBridgeChannelOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          Foreground="#E8EEF5"
                                          Background="#111921"
                                          BorderBrush="#243547"
                                          Padding="10,6"
                                          FontSize="12">
                                    <ComboBoxItem Tag="Auto"
                                                  Content="Auto — Windows / HDMI 7.1 packing when output is 8 channels"/>
                                    <ComboBoxItem Tag="Internal"
                                                  Content="Internal — matrix order as shipped (SL/SR before BL/BR)"/>
                                    <ComboBoxItem Tag="WindowsHdmi7_1"
                                                  Content="Always Windows-style 7.1 (BL/BR then SL/SR) on 8 ch"/>
                                </ComboBox>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SonicOutlineBrush}" FontSize="11" Margin="0,8,0,0"
                                           Text="When an ACTIVE sink negotiates six or eight channels at 48 kHz, matrix mode expands stereo before this reorder step (6 ch unchanged). Choose Internal if surrounds sound swapped on your gear. Power-cycle the bus after changing order."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Modern Title Bar Overlay -->
        <ui:TitleBar Grid.Row="0" Grid.RowSpan="2" Title="" Height="32" VerticalAlignment="Top" Background="Transparent"/>
    </Grid>
</ui:FluentWindow>
